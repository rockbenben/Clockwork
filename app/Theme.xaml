<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:loc="clr-namespace:Clockwork.I18n">

    <!-- ============ Clockwork · Blued steel & brass ============ -->
    <!-- 蓝钢暗色 + 强调色强调。取自「擒纵机构」定位：安静的仪器，只在关键处发亮。 -->

    <!-- 颜色不在这儿：它们在 Palette.Dark.xaml / Palette.Light.xaml，由 App 在启动时选一份合进来。
         下面这些画笔用 DynamicResource 指过去，于是**换掉那份字典就是换主题**——
         用 StaticResource 的话，样式在解析时就把画笔实例连同颜色一起定死了，之后再换字典也不会变。 -->
    <SolidColorBrush x:Key="BrushInk"       Color="{DynamicResource Ink}"/>
    <SolidColorBrush x:Key="BrushSlate"     Color="{DynamicResource Slate}"/>
    <SolidColorBrush x:Key="BrushSteel"     Color="{DynamicResource Steel}"/>
    <SolidColorBrush x:Key="BrushLine"      Color="{DynamicResource Line}"/>
    <SolidColorBrush x:Key="BrushPaper"     Color="{DynamicResource Paper}"/>
    <SolidColorBrush x:Key="BrushMuted"     Color="{DynamicResource Muted}"/>
    <SolidColorBrush x:Key="BrushFaint"     Color="{DynamicResource Faint}"/>
    <SolidColorBrush x:Key="BrushAccent"     Color="{DynamicResource Accent}"/>
    <SolidColorBrush x:Key="BrushAccentDeep" Color="{DynamicResource AccentDeep}"/>
    <!-- 强调色有两种用法，画笔就得有两把：BrushAccent 当填充（上面压深色字），
         BrushAccentText 当文字。深色下两者同色，浅色下后者压深，否则奶白纸上的强调色字读不出来
         （实测 #C88418 在 #F3EEE1 上只有 3.3:1，远不够）。 -->
    <SolidColorBrush x:Key="BrushAccentText"  Color="{DynamicResource AccentText}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{DynamicResource AccentHover}"/>
    <SolidColorBrush x:Key="BrushDanger"      Color="{DynamicResource Danger}"/>
    <!-- 只给擒纵轨用（TickAccent）。它是界面上唯一不用强调色的有色元素，理由见 Palette.Dark.xaml。 -->
    <SolidColorBrush x:Key="BrushBrass"       Color="{DynamicResource Brass}"/>
    <SolidColorBrush x:Key="BrushAccentTint" Color="{DynamicResource Accent}" Opacity="0.12"/>
    <SolidColorBrush x:Key="BrushDangerTint"  Color="{DynamicResource Danger}"  Opacity="0.18"/>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Accent}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentDeep}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ 擒纵刻度（竖向） ============ -->
    <!-- 一格 = 6px 齿 + 4px 齿隙。**这里的分段是信息**：一格就是一个时间单位，能数出还剩几格。
         提醒卡片 / 弹窗左缘的轨用它；不涉及时间的对话框用实心细轨。
         标签页选中下划线与面板翻页指示曾经也用这个节拍，后来都改成了实心——
         那两处的分段什么都不表示，读起来只像渲染瑕疵。见 Views/EscapementRail.cs。 -->
    <DrawingBrush x:Key="TickSteel" TileMode="Tile" Viewport="0,0,3,10" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource BrushSteel}">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,6"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- 点亮的格子用黄铜而不是强调色：与应用图标同一种材质，而这条轨就是图标那个隐喻本身。 -->
    <DrawingBrush x:Key="TickAccent" TileMode="Tile" Viewport="0,0,3,10" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource BrushBrass}">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,6"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="TickDanger" TileMode="Tile" Viewport="0,0,3,10" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource BrushDanger}">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,6"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- fonts (all Windows-native, no external dependency) -->
    <FontFamily x:Key="FontDisplay">Bahnschrift, DIN, Segoe UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI, Microsoft YaHei, PingFang SC</FontFamily>
    <!-- 等宽体只给「机器读数」：端口 / PID / 地址 / 时间 / 版本号 / 快捷键 / ×N。
         凡是会被翻译的词都不要用它。
         实测（CharacterToGlyphMap 逐码位探）本软件这 18 种语言用到的文字里，Cascadia Mono 只有
         拉丁、西里尔、希腊；阿拉伯、天城文、泰文、汉字都没有，交给系统回退——
         而等宽主字体下回退到的还是等宽体：阿拉伯语「منفذ」被拆成「مـنـفـذ」，
         字母塞进固定格子、连写断掉，同一行的正文字体则正常。
         改字体栈救不了：把 Consolas 从这一行去掉后重拍，阿拉伯语表头逐像素不变
         （ImageChops 差异框为 None——回退表不看这个列表）。
         中日韩没暴露只是因为方块字本来就不连写，断无可断；
         也就是说这套等宽标签本来就只对拉丁/西里尔/希腊成立。 -->
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!-- ============ ScrollBar (slim) ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{StaticResource BrushLine}" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBlock ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 表单里的说明。与通用 Hint（12px）分开：它们现在独占一列，
         位置已经把主次说清楚了，再叠一层缩字号是三重编码同一件事，
         代价是本就承载实信息的句子（0–600 秒、最多等 90 秒、Esc 取消 / Del 清空）更难读。
         颜色维持 Muted（对 Ink 背景 6.6:1，过 WCAG AA）——再暗一档的 Faint 只有 3.3:1，
         当正文用是不合格的，所以层级靠「标签变亮」而不是「说明变暗」。
         页脚那类 Hint 不跟着改：它们是长段落的次要 chrome，放大会把已经四行的端口页页脚再推长一行。 -->
    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- ============ Expander（编辑器的折叠区） ============
         标题不是「高级选项」这类死文案，而是调用方填入的一句行为描述（见步骤/提醒编辑器的
         UpdateCondHeader / UpdateAdvHeader）：收起时那一行字就是当前配置的完整摘要。
         标题用 Grid 而非横向 StackPanel 排——条件一多标题会很长，StackPanel 给的宽度无限、
         永不换行、超出被裁（pitfalls 里那张容器语义表的第一行），Grid 的 * 列才能让它换行。 -->
    <Style TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="Transparent" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 标题顶格、箭头挂行尾（Win11 展开卡的布局）：表单标签已全部左对齐在 0 轨，
                                                 标题若前置箭头就会被顶出半个字宽，成为全表单唯一不在轨上的一行。
                                                 试过反过来给箭头留定宽槽位、把折叠区内自由行也缩进对齐箭头槽——
                                                 那是在右对齐标签的锯齿左缘上打补丁，两条轨永远差一口气；左对齐后一条轨就够了。 -->
                                            <TextBlock Grid.Column="0" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushMuted}"/>
                                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="▸" FontSize="11" Margin="8,1,2,0"
                                                       VerticalAlignment="Top" Foreground="{StaticResource BrushAccentText}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource BrushAccentDeep}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表单类滚动区：内容与滚动条之间留一条呼吸缝。
         滚动条是上面那条 10px 细条，而默认模板会把内容一直铺到它跟前。定宽控件还好（右边总能剩点），
         真正贴住的是那些换行的说明文字——它们只有左边距、没有宽度，会一路铺满可用宽度，
         于是每一行都正好顶在滚动条上，读起来像被挤住了。
         Padding 加在 ScrollViewer 上正好只撑开这条缝：默认模板把它落到内容承载器的 Margin 上，
         而滚动条在另一个网格列里，不受影响。底部也留一点——提醒编辑器允许横向滚动，
         横条冒出来时会同样贴住最后一行。 -->
    <Style x:Key="FormScroll" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="0,0,12,6"/>
    </Style>
    <!-- 分组标签（「选中的行」「步骤」）同样是译文，不走等宽体。 -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Margin" Value="2,10,0,3"/>
    </Style>

    <!-- ============ Button (default = ghost/steel) ============ -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="Background" Value="{StaticResource BrushSteel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="7,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 按钮文字可换行：长译文(如德语「Diesen Schritt ausführen」)在窄侧栏按钮里换行而非被截断。
             Foreground 必须显式回绑按钮：模板里这个 TextBlock 会命中全局 TextBlock 样式的 Paper，
             把按钮自己的前景色盖掉——DangerButton 的 clay 文字色因此一直没生效过（四个「删除」按钮全是纸白）。 -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <!-- 键盘焦点环：内嵌 2px 强调色环，不改变布局(不像加边框那样把内容挤动 1px)。
                             暗色自绘模板下系统默认的虚线焦点框几乎不可见——没有它，"焦点默认落在稍后"就等于没落。 -->
                        <Border x:Name="ring" CornerRadius="8" BorderBrush="{StaticResource BrushAccent}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSlate}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource AccentGrad}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <!-- 主按钮本身就是实心强调色，焦点环走白色（与按钮上的文字同色），在蓝底上读得最清。 -->
                        <Border x:Name="ring" CornerRadius="8" BorderBrush="#FFFFFF" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDeep}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 破坏性按钮：只把文字换成 clay，保留和同列其它按钮一样的钢底＋描边。
         原来还抽掉了底色和描边——在一竖排包着框的按钮里，「删除」变成一条悬空的文字，
         把列的节奏戳了个洞。降调一次就够（不给强调色），不必降两次。 -->
    <!-- 打开选择器的那类按钮（浏览… / 选择… / 选日期）只画一个「…」，不带文字。
         带文字的版本在别的语言里会把整行撑破：中文「浏览…」三个字，德语是 Durchsuchen…、俄语 Обзор…。
         而这些按钮都排在一行的最右端，那一行又是水平 StackPanel——它给子元素的可用宽度是无限，
         所以超出的部分不会换行也不会压缩，而是被上层的 ScrollViewer 直接裁掉：按钮显示不全、点不着。
         换成「…」之后整行全部定宽，与语言无关，从根上不会再溢出。
         「…」是 Windows 上「点开会弹个选择框」的通用记号；文案没有丢，挪到了 ToolTip 与朗读名上，
         鼠标停一下能看到，读屏软件照样念得出来。
         BasedOn 是承重的：具名样式不会自动继承隐式 Button 样式，漏了这一句按钮会掉光配色和模板。 -->
    <Style x:Key="PickerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="…"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
    </Style>

    <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushAccentText}"/>
        <Setter Property="Background" Value="{StaticResource BrushAccentTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentDeep}"/>
    </Style>

    <!-- 纯图形的方形小按钮（急停）：内容是图形不是字符串，所以要把默认 Button 的 ContentTemplate 拆掉——
         那个 DataTemplate 是 <TextBlock Text="{Binding}">，喂给它一个图形对象只会画出类型名。
         悬停改 Background 而不是像默认按钮那样只描边：这是个危险动作，手放上去要看得出来。
         默认模板里 bd 的 Background 就是 {TemplateBinding Background}，故样式触发器能直接接管；
         按下态由模板自身的 TargetName 触发器接手(Slate)，两者不冲突。 -->
    <!-- 动作格：图标在上、文字在下，扁平无边框。尺寸由代码按「紧凑/标准/宽松」档位设置，
         所以这里不写 Width/Height——写了会覆盖掉用户选的档位。
         刻意不继承全局 Button 样式：那一套是给「确定 / 取消」这类实心按钮做的（钢底 + 边框），
         一屏铺十几个下来全是框，视觉噪音盖过内容本身。这里反过来——常态完全透明，
         只有指到的那一格亮起来，眼睛跟着指针走。 -->
    <Style x:Key="Tile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
            <Grid>
                <Border x:Name="bd" Background="Transparent" CornerRadius="7" SnapsToDevicePixels="True"/>
                <!-- 焦点环独立一层：加边框会把内容挤动 1px，而暗色自绘模板下
                 系统默认的虚线焦点框几乎看不见——没有它，「焦点默认落在第一格」等于没落。 -->
                <Border x:Name="ring" CornerRadius="7" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                    Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSteel}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- 停用：整格压暗而不是隐藏（「它被关掉了」和「它没了」得分得清），
                 同时收掉手型光标——一个点不动的格子不该看着像能点。 -->
                <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签条右端那两颗管理器按钮。与 IconDangerButton 同尺寸同形状，只是不带危险语义：
         它们是入口，不是动作，所以描边用普通的 Line、悬停才提亮。
         纯图标按钮必须有 ToolTip 与 AutomationProperties.Name（调用方给），图形本身不可读。 -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="ContentTemplate" Value="{x:Null}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
        <!-- clay 描边不是装饰：没有轮廓时，深色底上一块实心暖色只会被读成状态指示灯而不是可点的控件
             （真机比对过实心方块/实心八边形/空心八边形等七版，差别就在这道边上）。 -->
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
        <Setter Property="ContentTemplate" Value="{x:Null}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerTint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 对话框页脚按钮：五个对话框(步骤/提醒/动作组编辑器、品牌对话框、提醒弹窗)原来各写各的尺寸——
         80×32 / 88×34 / 72×34 三套并存，同一套「确定 取消」在不同窗口里高矮胖瘦都不一样。
         一处定义，各处引用；主次只差样式，尺寸恒等（长译文靠 MinWidth 之上自然撑开）。 -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Height" Value="34"/>
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <!-- ============ TextBox ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Background" Value="{StaticResource BrushInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <!-- 内容宿主铺满并按 VerticalContentAlignment 居中——原来 SV 自身居中+默认顶对齐会让文字整体下沉、底部被裁。 -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 多行框(AcceptsReturn)顶对齐：居中只为单行框防下沉，多行框居中会让短文本浮在中间、光标起点错位。 -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ CheckBox (brass check) ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 全 App 的复选框文案一律可折行：本应用 18 种语言，同一句话德/俄/西比中文长一倍有余，
             写死不折行等于把「窄窗口 + 长译文」这一格永远留成裁切。 -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Grid(Auto|*) 而不是横向 StackPanel：StackPanel 给子元素的可用宽度是无限的，
                         ContentPresenter 永远拿不到宽度约束，配套的 TextWrapping 也就永远不触发 ——
                         德语的「Warten, bis das System bereit ist (Desktop / Netzwerk)」正是这么被硬切成半个词的。 -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="box" Grid.Column="0" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="{StaticResource BrushFaint}" BorderThickness="2">
                            <Path x:Name="tick" Data="M 3,8 L 7,12 L 14,4" Stroke="{StaticResource BrushPaper}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 勾上**不填强调色**：启动清单里几乎每行都勾着，一列强调色方块比内容还响。
                             改成中性描边 + 正文色的勾——勾本身就说清了「开着」，不需要一块色斑来喊。 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BrushMuted}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ RadioButton ============ -->
    <!-- 没有这份样式时，两颗单选钮会退回 WPF 自带的浅色模板：未选中＝一颗实心白点、选中＝白圈套暗心，
         在暗底上恰好读反——真机比对过，「静默运行动作组」看着比「弹窗提醒」更像被选中的那个。
         与 CheckBox 同一套语汇（中性环 + 正文色的点），只把方框换成圆点。
         选中态不用强调色，理由同 CheckBox：点本身已经说清「选的是这个」。
         这也顺带解开一处撞车——原来 hover / 聚焦 / 选中都把环染成强调色，
         鼠标扫过没选的那一项，它看着就跟选中的一样，只差中间那个点。
         现在环的颜色只表示「鼠标/焦点在这儿」，选中与否一律由点来说。 -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Stroke="{StaticResource BrushFaint}" StrokeThickness="2" Fill="Transparent"/>
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource BrushPaper}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrushMuted}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ListBox（进程选择器）============ -->
    <!-- 同上：不给样式就是 WPF 自带的白底列表，而全局 TextBlock 样式又把文字定成 paper 米白——
         白底米白字，进程列表实测几乎读不出来。 -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrushInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSteel}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentTint}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 面板的两条导航栏 ============ -->
    <!-- 页签（左栏）：一页一条。选中态由代码涂（底色 + 左缘那条强调色竖杠 + 亮一档的字），
         因为条目是按当前分类现建的，写不成静态触发器。左缘留 2px 边就是给那条竖杠的位置——
         未选中时它是透明的，所以选中与否不会让文字左右挪动。 -->
    <Style x:Key="PanelPageTab" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSteel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分类（上栏）：选中态是强调色文字 + 下划线。同页签，涂色在代码里。 -->
    <Style x:Key="PanelTopTab" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSteel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Calendar（选日期）============ -->
    <!-- 只改颜色、不重写日历模板：自带模板的日期网格已经好用，缺的只是暗色配色。
         CalendarItem 的边框底色写死在自带模板里，故这里连它一起接管（仅换 Border 的底/描边）。 -->
    <Style x:Key="CalDayBtn" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 非本月的日子退到 faint：网格边缘的补位，不该跟本月同样响 -->
                        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushFaint}"/></Trigger>
                        <Trigger Property="IsToday" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccentDeep}"/><Setter TargetName="bd" Property="BorderThickness" Value="1"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSteel}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 月/年层的格子（点标题切到「选月份」「选年份」时用），与日格同一套配色 -->
    <Style x:Key="CalMonthBtn" TargetType="CalendarButton" BasedOn="{StaticResource CalDayBtn}"/>
    <!-- CalendarItem 必须重写模板：系统自带模板里嵌着一圈写死的 2px 纯白内描边
         （Aero2 里 BorderBrush="#FFFFFFFF"），配色改不掉它——暗色对话框中央因此永远框着一个白盒子。
         月/年视图的切换不用管：CalendarItem 自己按 PART_MonthView / PART_YearView 这两个名字
         找到网格并直接改 Visibility，模板只负责按名字把两个空 Grid 摆好、行列数给对。 -->
    <Style x:Key="CalItem" TargetType="CalendarItem">
        <Setter Property="Background" Value="{StaticResource BrushSlate}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <!-- 日名行（一 二 三…）：自带模板给的是浅色主题下的灰，暗底上几乎看不见。
                         走列名同款——小字 + faint，和 DataGrid 表头一个口径（两边都已从等宽体挪走，
                         理由见 FontMono 定义处：这两处印的都是译文）。
                         必须放在模板资源里：FrameworkElement.Resources 不是依赖属性，
                         写成 <Setter Property="Resources"> 会在运行时抛 XamlParseException。 -->
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <!-- 星期名按语言变（日月火…／SMTWTFS／阿拉伯语），是译文不是读数 -->
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,2,0,8"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushFaint}"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushLine}"
                            BorderThickness="1" CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="‹" Width="30" Height="28" Padding="0"/>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Height="28" Margin="6,0"
                                        FontFamily="{StaticResource FontDisplay}" FontSize="14"/>
                                <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Width="30" Height="28" Padding="0"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid x:Name="PART_MonthView" Visibility="Visible">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                </Grid>
                                <Grid x:Name="PART_YearView" Visibility="Hidden">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 三个子样式必须显式挂上：隐式样式在 Calendar 的自带模板里接不上（模板是把
         CalendarItemStyle / CalendarDayButtonStyle 直接绑到子元素的 Style 上的），
         不挂就只有 Foreground 靠继承生效，选中日期仍是系统默认的浅蓝。 -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource BrushSlate}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource CalItem}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalDayBtn}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalMonthBtn}"/>
    </Style>

    <!-- ============ ComboBox ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="Background" Value="{StaticResource BrushInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"/>
                        <ToggleButton Focusable="False" Background="Transparent" BorderBrush="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="cp" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
                        <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource BrushMuted}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource BrushSlate}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                    CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="320">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccentDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TabControl / TabItem ============ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
                            <!-- 标签条两列：左＝标签本身，右＝挂在 Tag 上的常驻控件（急停按钮）。
                                 右侧控件不做成「在窗口根 Grid 上浮一层」——那样 TabPanel 不知道右边被占，
                                 而 18 种语言的标签总宽差很多（德语/俄语明显更长），窗口拉到 MinWidth 时
                                 标签会钻到按钮底下。占掉一列才是真约束。Tag 为空时这一列不占地方。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- WrapPanel 而非 TabPanel：标签条放不下而折行时，TabPanel 会把「选中标签所在的那一行」
                                     挪到最靠近内容区的位置——经典带边框的选项卡需要这个，本扩平设计不需要。
                                     代价是阅读顺序变成 4,5,6 / 1,2,3，而且换一个标签页两行就对调，
                                     你要找的标签会自己移位（俄语 @820 实测）。WrapPanel 按阅读顺序折行、不重排，
                                     且标签保持内容宽度左对齐，不再被拉伸填满行宽。 -->
                                <WrapPanel Grid.Column="0" IsItemsHost="True" Margin="4,0,0,0" Background="Transparent"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center" Margin="10,0,6,5"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="Transparent">
                            <!-- 名字不能改：TabControlAutomationPeer 按 "PART_SelectedContentHost" 这个名字找选中页的
                                 内容宿主，找不到就不把内容挂进无障碍树。本模板原来没给名字，于是六个标签页里的所有控件
                                 对读屏软件整体不可见（UIA 树里只剩窗口＋6 个标签头）。 -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border Padding="14,10">
                            <ContentPresenter x:Name="hdr" ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- 选中指示：3px 实心圆头条。原来是 6px 齿 + 4px 隙的平铺虚线（旧标识留下的节拍），
                             1:1 下读起来像渲染瑕疵或一条点线分隔符，不像「这个标签是选中的」；
                             3px 而非 2px，是因为标签字号 15，2px 压不住。

                             宽度绑到标题本身而不是标签格子：不折行时两者相等（Padding 14 与原来的 Margin 14 正好抵消），
                             一旦标签条放不下而折成两行，TabPanel 会把每个标签拉伸填满行宽，
                             这条线会跟着拉到文字的两三倍长（俄语 @820 实测：「Порты」下面的线长达 180px）。 -->
                        <Border x:Name="tick" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                Background="{StaticResource BrushAccent}"
                                Width="{Binding ActualWidth, ElementName=hdr}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ DataGrid ============ -->
    <!-- 列名不走等宽体：它们条条都要翻译，而等宽体排不了阿拉伯语的连写（见 FontMono 处的说明）。 -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <!-- 用可换行的 TextBlock 取代 ContentPresenter：长译文(如德/俄的列名)在窄列里换行而非被截断 -->
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 勾选列的表头：单元格里的复选框是居中的，表头却默认左对齐——一列两条基准线，
         列一窄（启用 52px / 语音 56px）就明显歪。这两列专用居中表头。 -->
    <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文本列单元格：列宽有限、内容常被截断（步骤摘要 / 提醒文本 / 组名 / 系统项路径）。
         默认 DataGridTextColumn 是硬裁——半个字被切掉，看不出还有下文，也没法读全。
         省略号收尾 + 始终挂 tooltip=本单元格全文，hover 即可看全，不丢信息。
         原来只有「系统启动项」页享受这个待遇（那时叫 SysCell），其余三个列表页照样硬裁。 -->
    <Style x:Key="CellEllipsis" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Style.Triggers>
            <!-- 空单元格不挂提示：热键列多数行是空的，挂上等于 hover 就弹一个空框 -->
            <Trigger Property="Text" Value=""><Setter Property="ToolTip" Value="{x:Null}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- 悬停用 steel(比面板 slate 更亮)才看得出——列表面板本身是 slate -->
                <Setter Property="Background" Value="{StaticResource BrushSteel}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentTint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 表头左上角那个「全选」按钮：只在 HeadersVisibility=All（即打开了拖动手柄的表）才出现，
         默认样式是系统白底方块，在深色表头上像块补丁。它对本程序也没有意义——三个列表都是
         SelectionMode=Single，全选无从谈起。抹平成透明，只留表头那条底线接上。
         必须用 ComponentResourceKey 定位：这个按钮由 DataGrid 模板内部实例化，没有别的挂钩点。 -->
    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 拖动手柄：行首那条窄带。只有支持拖拽重排的表才套上它（见 DataGridReorder.Attach）——
         「画了手柄」与「拖得动」必须同真同假，否则不是骗人就是把功能藏起来。
         平时极淡、行悬停时提亮：不抢视线，但鼠标一到那一行就告诉你这里能抓。
         Segoe MDL2 Assets 的 E76F(GripperBarHorizontal)，与托盘菜单同一个图标族。 -->
    <Style x:Key="DragGripRowHeader" TargetType="DataGridRowHeader">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Cursor" Value="SizeAll"/>
        <!-- DataGridRowHeader 是个 ButtonBase，每行一个。
             不进 Tab 序：拖拽用不了键盘，让它抢 27 次焦点纯属妨碍——同样的重排请用侧栏的
             上移/下移按钮，那两个可聚焦、有名字、键盘可达。
             给名字则是因为模板里放的是一个私有区字形（E76F）：不命名的话读屏软件会去念那个
             字符本身，念出来是一段乱码。WPF 没有 WinUI 那种把元素整个移出无障碍树的开关
             （AutomationProperties.AccessibilityView 是 WinUI 独有），能做的就是让它说人话。 -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="AutomationProperties.Name" Value="{loc:Loc A11y_DragHandle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border Background="Transparent" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="Grip" Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource BrushFaint}" Opacity="0.45"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="Foreground" Value="{StaticResource BrushAccentText}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
    </Style>

    <!-- 列表面板：把表格包成一块蓝钢面板，条目少时下方空白也是有形的面板表面，
         而非直接露出 ink 地色的"暗色空洞"。四个列表页(启动/提醒/动作组/系统)共用。 -->
    <Style x:Key="ListPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSlate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ============ 启动清单左缘的顺序轨（启用=亮、未启用=暗） ============ -->
    <!-- 原来是「启用=强调色」。方向反了：**启用才是常态**——没人会把启动项全关掉——
         于是强调色落在每一行上，一整列发亮，而它旁边的勾选框也是强调色，一行亮两处。
         真正有信息的类型徽标和摘要反倒是灰的，屏幕上最响的成了最不用看的。
         强调色的职责是「只在关键处发亮」，这里改用**明暗**区分开关，把它还给选中行、主按钮、当前标签。 -->
    <!-- 轨道列须去掉默认单元格内边距（12,9），否则 24px 窄列会被内边距吃光、轨道不可见。 -->
    <Style x:Key="RailCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <DataTemplate x:Key="RailCell">
        <Grid Width="20" Height="40">
            <Rectangle x:Name="spine" Width="2" Fill="{StaticResource BrushSteel}" HorizontalAlignment="Center"/>
            <Ellipse x:Name="node" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{StaticResource BrushInk}" Stroke="{StaticResource BrushSteel}" StrokeThickness="2"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Enabled}" Value="True">
                <Setter TargetName="spine" Property="Fill" Value="{StaticResource BrushMuted}"/>
                <Setter TargetName="node" Property="Stroke" Value="{StaticResource BrushMuted}"/>
                <Setter TargetName="node" Property="Fill" Value="{StaticResource BrushMuted}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ ContextMenu / MenuItem（「新增 ▾」等下拉，默认是白色，须主题化） ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BrushSlate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGesture"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="gesture" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource BrushMuted}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                       VerticalAlignment="Center" Margin="28,0,0,0"/>
                            <Path Grid.Column="2" x:Name="arrow" Data="M 0,0 L 4,4 L 0,8 Z" Fill="{StaticResource BrushMuted}"
                                  VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource BrushSlate}" BorderBrush="{StaticResource BrushLine}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="2,0,0,0"
                                        Grid.IsSharedSizeScope="True">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="arrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentTint}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
                            <Setter TargetName="gesture" Property="Foreground" Value="{StaticResource BrushFaint}"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="{x:Null}">
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ContextMenu 区段小标题（不可点击、无悬停、紧凑字号与字色，同托盘菜单 TrayMenu.Header） ============ -->
    <Style x:Key="MenuHeader" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8,12,3"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ============ ToolTip（系统启动项单元格全文提示等，默认是白色，须主题化） ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BrushSteel}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <!-- 长命令行/路径在 MaxWidth 内换行显示，而非拖出一条超宽白条 -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BrushLine}" Margin="6,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置页卡片：蓝钢面板，把设置从 ink 地色上抬起来分组 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSlate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,20"/>
    </Style>

    <!-- 设置项标签（右对齐、钢灰） -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <!-- Paper 而非 Muted：标签是用来扫的，得看得清。而且复选框的文字本来就是 Paper，
             「开机延迟」（FieldLabel）暗、「等系统就绪」（复选框）亮，同一列的同类东西两种亮度。 -->
        <Setter Property="Foreground" Value="{StaticResource BrushPaper}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <!-- 左对齐（曾是 Right）：右对齐标签配上长短悬殊的中文标签，表单左缘是一条锯齿，
             子标题放哪都跟它对不齐；Win11 设置页同款的左对齐标签 + 固定输入列才是这套布局的正解。 -->
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <!-- 急停键捕捉框：只读、点击后按下快捷键即捕捉；获焦时强调色边框提示「就绪」 -->
    <Style x:Key="HotkeyCapture" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushAccentText}"/>
        <Setter Property="Background" Value="{StaticResource BrushInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccentDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- type chip (类型列) -->
    <Style x:Key="KindChip" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
    </Style>
    <!-- 类型徽标底 + 延时等宽读数：启动清单与动作组步骤列表共用（从 MainWindow 移来，两处一致口径）。 -->
    <Style x:Key="KindChipCell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSteel}"/>
        <!-- 描边不是装饰：行悬停色也是 steel，与徽标底同色——没有这道边时，鼠标一划过，
             类型徽标就整块融进行背景，只剩一行悬空的字。 -->
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DelayCol" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 等宽读数的省略号版：热键 / 命令行 / 端口 / PID / 地址五列在用。
         共同点是内容都由机器给定、不经翻译，正是可以放心进等宽体的那一类（反面见 FontMono 处的说明）。
         见上方 CellEllipsis 的说明，字体走 DelayCol。
         定义必须排在 DelayCol 之后——StaticResource 只认字典里已经出现过的键。 -->
    <Style x:Key="CellEllipsisMono" TargetType="TextBlock" BasedOn="{StaticResource DelayCol}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="ToolTip" Value="{x:Null}"/></Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
