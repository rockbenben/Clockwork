<Application x:Class="Clockwork.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Clockwork">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 顺序要紧：调色板必须在 Theme 之前。Theme 里的画笔用 DynamicResource 指颜色，
                     运行时 App 会把这一份换成 Palette.Light.xaml（见 ApplyTheme）。 -->
                <ResourceDictionary Source="Palette.Dark.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
