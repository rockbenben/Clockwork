<Project>
  <!-- 默认发布形态：自包含单文件 exe，运行时打进去，下载即用。
       这些属性只在 publish 时生效——挂在 csproj 上会让日常 dotnet build / dotnet run 也走
       RID 专属 + 单文件 + 压缩的路径，白白变慢；而且自包含的可执行工程不能被测试工程引用
       （NETSDK1151），app.Tests 跑在 MTP 上之后本身就是 exe，会直接构建失败。 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 这里刻意不开 PublishReadyToRun。体积代价是实测的：自包含 72.4 → 77.7 MB（+5.3 MB）。
         启动收益则始终没量出来——两种发布形态里 .NET 框架程序集本来就是预编译的原生映像，
         R2R 能作用的只有 Clockwork 自己那 ~500 KB，而这个应用的启动时间大头在进程创建与
         WPF 图形栈初始化上。为一个没证实的收益给「下载即用」这一版多背 5 MB，不划算。
         框架依赖那份开着，是因为那边的代价只有 +478 KB，不是因为量到了收益。 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 发布目录只留一个 exe：不生成 pdb，也不把引用工程的 pdb 复制过来。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\publish\</PublishDir>
  </PropertyGroup>
</Project>
