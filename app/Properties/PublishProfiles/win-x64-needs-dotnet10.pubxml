<Project>
  <!-- 同样的单文件 exe，只是不带 .NET 运行时：体积只有零头，但要求目标机器已装
       .NET 10 桌面运行时。这里刻意不设 EnableCompressionInSingleFile——单文件压缩只对自包含
       成立，框架依赖版传它会以 NETSDK1177 直接失败。
       同理不设 IncludeNativeLibrariesForSelfExtract：框架依赖版的 bundle 里没有运行时原生库可打包，
       那个开关在这儿没有任何东西可作用，留着只会让读的人以为它有用。 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 提前编译成机器码，省掉启动路径上这点 JIT。体积实测 1.28 → 1.73 MB（+478 KB）。
         启动收益没量出来：一组样本看着快约 45 毫秒，但不带 R2R 那一列当时还在随文件缓存变热
         继续下降（980 → 931 → 906），900 毫秒量级上的 45 毫秒分不清是 R2R 还是测得太早。
         开着的理由因此不是收益，而是代价可以忽略——框架程序集本来就是预编译的原生映像，
         R2R 能作用的只有本程序自己那 ~500 KB，指望不上大提升。
         自包含那份同样没量到收益、代价却是 +5.3 MB，所以那边关掉：两份取值不同是因为代价不对称。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 发布目录只留一个 exe：不生成 pdb，也不把引用工程的 pdb 复制过来。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\publish-needs-dotnet10\</PublishDir>
  </PropertyGroup>
</Project>
