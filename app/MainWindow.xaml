<Window x:Class="Clockwork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clockwork"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        mc:Ignorable="d"
        Title="Clockwork" Height="720" Width="1040" MinHeight="420" MinWidth="820"
        Background="{StaticResource BrushInk}"
        Icon="/logo.ico" WindowStartupLocation="CenterScreen">
    <!-- 单元格省略号样式（原来叫 SysCell / SysCmdCell、只在本页用）已升到 Theme.xaml 的
         CellEllipsis / CellEllipsisMono：四个列表页的文本列共用同一口径，不再只有系统启动项一页享受。 -->
    <Grid>
        <!-- StripTabControl：只比 TabControl 多一件事——把标签条右端 Tag 里的控件补进无障碍树（见该类注释）。
             隐式样式按精确类型匹配，子类不会自动套用，故显式引用 TabControl 的那份。 -->
        <local:StripTabControl x:Name="Tabs" Style="{StaticResource {x:Type TabControl}}" Margin="8,4,8,6">
            <!-- 急停：托盘菜单、全局热键之外的第三个入口，也是唯一一个在界面上看得见的——
                 不看文档的人既不知道托盘里有这一项、也不知道热键，动作跑起来时就没有「停」可按。
                 常驻，空闲时也不置灰：空点一下无害（置位会被下一路运行的 RunGate.Begin 清掉），
                 而正慌的人看到一个灰按钮只会以为程序坏了。文案/朗读名在 RefreshStopHint 里给。 -->
            <!-- 标签条右端这一排：两个管理器 + 急停。
                 放这儿的理由：它们是**全局工具**，不属于任何一页 —— 而且不是设置。
                 早先面板管理器挂在动作组页侧栏、手势管理器在设置页里当一行，
                 两个同类东西在两个互不相干的地方；放进设置又把「内容编辑」混进了「开关」。
                 这里从任何标签页都是一步可达，两者地位相同、位置相邻。

                 图标一律画矢量，不用 Segoe MDL2 —— 与急停按钮同一条理由（见下）：
                 精简 SKU 可能没装那套字体，纯图标按钮变成豆腐块就彻底不可读了。
                 手势那颗画的就是一条笔迹：它的图标是它自己。 -->
            <local:StripTabControl.Tag>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PanelManageBtn" Style="{StaticResource IconButton}" Click="PanelManager_Click"
                            ToolTip="{loc:Loc Settings_PanelManage}" AutomationProperties.Name="{loc:Loc Settings_PanelManage}">
                        <!-- 2×2 格阵 = 面板 -->
                        <Canvas Width="13" Height="13">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5.5" Height="5.5" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Rectangle Canvas.Left="7.5" Canvas.Top="0" Width="5.5" Height="5.5" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="5.5" Height="5.5" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Rectangle Canvas.Left="7.5" Canvas.Top="7.5" Width="5.5" Height="5.5" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="GestureManageBtn" Style="{StaticResource IconButton}" Click="GestureManager_Click"
                            ToolTip="{loc:Loc Settings_GestureManage}" AutomationProperties.Name="{loc:Loc Settings_GestureManage}">
                        <!-- 鼠标 = 手势。**与快捷面板表圈那颗手势按钮同一个符号**（那边用的是
                             MDL2 的 E962 Mouse），同一个入口在两处不该长成两个样子。
                             这里描成矢量而不是直接用那个字形，是这条标签条的通例：精简 SKU 可能没装
                             Segoe MDL2 Assets，纯图标按钮一旦变成豆腐块就彻底不可读（同急停按钮的理由）。
                             几何是照着 E962 描的：顶部半圆（r4）、底部小圆角（r3）、滚轮是顶边下来的一小竖。
                             线宽 1.25 而不是这条上其它图标的 1.7——描边图形按 1.7 画，14px 下内腔会糊死。

                             注意：这颗是**功能入口**的图标，与管理器列表里那些笔迹缩略图是两回事——
                             那些必须画成真实轨迹（GestureGlyph），认一条手势靠的是形状。 -->
                        <Canvas Width="14" Height="13">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 3,4.8 A 4,4 0 0 1 11,4.8 L 11,9.2 A 3,3 0 0 1 8,12.2 L 6,12.2 A 3,3 0 0 1 3,9.2 Z"/>
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,1.6 L 7,5.2"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="StopAllBtn" Style="{StaticResource IconDangerButton}" Click="StopAll_Click"
                            PreviewMouseDown="StopAll_PreviewMouseDown">
                        <!-- 与托盘菜单「停止正在运行的动作」同一个符号（MDL2 E71A 的实心方块），但画成矢量：
                             精简 SKU 可能没装 Segoe MDL2 Assets（TrayMenuRenderer 也为此留了退化分支），
                             纯图标按钮一旦变成豆腐块就彻底不可读了。 -->
                        <Rectangle Width="11" Height="11" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </local:StripTabControl.Tag>

            <!-- ===== 启动清单 ===== -->
            <TabItem x:Name="TabLaunch" Header="{loc:Loc Tab_Launch}">
                <!-- 两行：上＝列表+操作栏，下＝整宽脚注。说明文字原来塞在 168px 侧栏底部，
                     中文在那个宽度里会在任意位置断行（「仅某些/星期」），而且离它解释的列表隔着一大片空。 -->
                <Grid Margin="2,10,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ListPanel}">
                        <!-- 三个列表页禁点表头排序：清单顺序即执行/显示顺序，排序只改视图不改模型，
                             会让 SelectedIndex(视图序)与 Models(配置序)错位——删除/上移/复制会操作错行并落盘。 -->
                        <DataGrid x:Name="GridLaunch" AutomationProperties.Name="{loc:Loc Tab_Launch}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="GridLaunch_DoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Btn_Copy}" Click="LCopy_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="24" CanUserResize="False" CellTemplate="{StaticResource RailCell}" CellStyle="{StaticResource RailCellStyle}"/>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Enabled}" Width="52" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Kind}" Width="Auto" MinWidth="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KindChipCell}">
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource KindChip}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Summary}" Binding="{Binding Summary}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsis}"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Delay}" Binding="{Binding DelayText}" Width="80" IsReadOnly="True"
                                                    ElementStyle="{StaticResource DelayCol}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <!-- 侧栏裹一层滚动：外层是 * 行，工作区一矮按钮就被切掉，而 StackPanel 不会滚——
                             被切掉的那几颗是**真的点不到**（820×464 + 俄语实测：上移/下移/运行全在屏幕外）。
                             横向禁掉滚动条：这一列宽度固定 168，出横条只会是布局出错的征兆。 -->
                        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,0,0,0">
                            <!-- 小标题说的是这一列按钮作用于什么，而不是重复一遍标签页名（原来印的就是页名，
                                 在页名正下方三十几像素处，什么也没多说）。 -->
                            <TextBlock Text="{loc:Loc Side_SelectedRow}" Style="{StaticResource GroupLabel}" Margin="2,0,0,4"/>
                            <Button x:Name="LAdd" Content="{loc:Loc Btn_AddMenu}" Style="{StaticResource PrimaryButton}" Margin="0,3" Click="LAdd_Click"/>
                            <!-- 除「新增」外全部作用于选中行：没选中时整块置灰。
                                 原来它们一直可点，点了却因 SelectedStep==null 静默返回——按下去什么都不发生，
                                 与「坏了」无法区分（同一条道理已经在系统启动项的右键菜单上认过一次）。 -->
                            <StackPanel x:Name="LaunchRowOps" IsEnabled="False">
                                <Button x:Name="LEdit" Content="{loc:Loc Btn_Edit}" Margin="0,3" Click="LEdit_Click"/>
                                <Button x:Name="LDel" Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,3" Click="LDel_Click"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="LUp" Grid.Column="0" Content="{loc:Loc Btn_Up}" Margin="0,0,3,0" Click="LUp_Click"/>
                                    <Button x:Name="LDown" Grid.Column="1" Content="{loc:Loc Btn_Down}" Margin="3,0,0,0" Click="LDown_Click"/>
                                </Grid>
                                <Button x:Name="LRun" Content="{loc:Loc Btn_Run}" Style="{StaticResource RunButton}" Margin="0,10,0,2" Click="LRun_Click"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,12,2,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="2" Background="{StaticResource BrushLine}" Margin="0,1,9,1"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Launch_Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                </Grid>
            </TabItem>

            <!-- ===== 定时提醒 ===== -->
            <TabItem Header="{loc:Loc Tab_Reminder}">
                <Grid Margin="2,10,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ListPanel}">
                        <DataGrid x:Name="GridRemind" AutomationProperties.Name="{loc:Loc Tab_Reminder}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="GridRemind_DoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Btn_Copy}" Click="RCopy_Click"/>
                                    <MenuItem Header="{loc:Loc Btn_SkipToday}" Click="RSkip_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Enabled}" Width="52" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Time}" Binding="{Binding TimeLabel}" Width="Auto" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource DelayCol}"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Period}" Binding="{Binding PeriodLabel}" Width="Auto" MinWidth="120" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsis}"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Text}" Binding="{Binding Text}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsis}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <!-- 侧栏裹一层滚动：外层是 * 行，工作区一矮按钮就被切掉，而 StackPanel 不会滚——
                             被切掉的那几颗是**真的点不到**（820×464 + 俄语实测：上移/下移/运行全在屏幕外）。
                             横向禁掉滚动条：这一列宽度固定 168，出横条只会是布局出错的征兆。 -->
                        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{loc:Loc Side_SelectedRow}" Style="{StaticResource GroupLabel}" Margin="2,0,0,4"/>
                            <Button x:Name="RAdd" Content="{loc:Loc Btn_Add}" Style="{StaticResource PrimaryButton}" Margin="0,3" Click="RAdd_Click"/>
                            <StackPanel x:Name="ReminderRowOps" IsEnabled="False">
                                <Button x:Name="REdit" Content="{loc:Loc Btn_Edit}" Margin="0,3" Click="REdit_Click"/>
                                <Button x:Name="RDel" Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,3" Click="RDel_Click"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="RUp" Grid.Column="0" Content="{loc:Loc Btn_Up}" Margin="0,0,3,0" Click="RUp_Click"/>
                                    <Button x:Name="RDown" Grid.Column="1" Content="{loc:Loc Btn_Down}" Margin="3,0,0,0" Click="RDown_Click"/>
                                </Grid>
                                <Button x:Name="RPreview" Content="{loc:Loc Btn_Run}" Style="{StaticResource RunButton}" Margin="0,10,0,2" Click="RPreview_Click"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,12,2,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="2" Background="{StaticResource BrushLine}" Margin="0,1,9,1"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Reminder_Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                </Grid>
            </TabItem>

            <!-- ===== 动作组 ===== -->
            <TabItem Header="{loc:Loc Tab_Group}">
                <Grid Margin="2,10,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ListPanel}">
                        <DataGrid x:Name="GridGroup" AutomationProperties.Name="{loc:Loc Tab_Group}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="GridGroup_DoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Btn_Copy}" Click="GCopy_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Enabled}" Width="52" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Name}" Binding="{Binding Name}" Width="Auto" MinWidth="160" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsis}"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Summary}" Binding="{Binding Summary}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsis}"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Hotkey}" Binding="{Binding HotkeyLabel}" Width="Auto" MinWidth="110" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellEllipsisMono}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <!-- 侧栏裹一层滚动：外层是 * 行，工作区一矮按钮就被切掉，而 StackPanel 不会滚——
                             被切掉的那几颗是**真的点不到**（820×464 + 俄语实测：上移/下移/运行全在屏幕外）。
                             横向禁掉滚动条：这一列宽度固定 168，出横条只会是布局出错的征兆。 -->
                        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{loc:Loc Side_SelectedRow}" Style="{StaticResource GroupLabel}" Margin="2,0,0,4"/>
                            <!-- 与「定时任务」那一页同一颗按钮：只有一种东西可建，就不该先开个菜单。
                                 「新增 ▾」的 ▾ 是留给「必须先选一种类型」的（启动清单的步骤）。 -->
                            <Button x:Name="GAdd" Content="{loc:Loc Btn_Add}" Style="{StaticResource PrimaryButton}" Margin="0,3" Click="GAdd_Click"/>
                            <!-- 模板单独一颗。它与新增一样**不需要选中行**，所以留在 GroupRowOps 外面。
                                 用得不多（认识一遍就够），但必须看得见——步骤编辑器里「还没有动作」那句
                                 提示指的就是这条路。 -->
                            <Button x:Name="GTemplate" Content="{loc:Loc Btn_FromTemplate}" Margin="0,3" Click="GTemplate_Click"/>
                            <StackPanel x:Name="GroupRowOps" IsEnabled="False">
                                <Button x:Name="GEdit" Content="{loc:Loc Btn_Edit}" Margin="0,3" Click="GEdit_Click"/>
                                <Button x:Name="GDel" Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,3" Click="GDel_Click"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="GUp" Grid.Column="0" Content="{loc:Loc Btn_Up}" Margin="0,0,3,0" Click="GUp_Click"/>
                                    <Button x:Name="GDown" Grid.Column="1" Content="{loc:Loc Btn_Down}" Margin="3,0,0,0" Click="GDown_Click"/>
                                </Grid>
                                <Button x:Name="GRun" Content="{loc:Loc Btn_Run}" Style="{StaticResource RunButton}" Margin="0,10,0,2" Click="GRun_Click"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,12,2,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="2" Background="{StaticResource BrushLine}" Margin="0,1,9,1"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Group_Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                </Grid>
            </TabItem>

            <!-- ===== 系统启动项 ===== -->
            <TabItem x:Name="TabSystem" Header="{loc:Loc Tab_System}">
                <Grid Margin="2,10,2,2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- 右内边距 1px 对齐下方列表面板的右缘：面板带 1px 描边，不减这一格，
                         「显示系统/只读项」会比列表右缘再往外探出一点，成了整页唯一一处出栏的控件。 -->
                    <!-- 与端口页顶栏同一个结构：Grid(Auto|*) + WrapPanel。
                         原来搜索框与复选框同处一个单元格、靠左右对齐各据一端：两者都没有列去约束，
                         真放不下时不是换行、也不是被裁，而是**叠**在一起——比裁掉更难看懂。
                         现在还没到那一步（已渲染的六种语言里德语最挤，搜索框右缘到复选框左缘仍有 168px），
                         改的是结构而不是救火：越界方式从「重叠」变成「整块换行」，
                         而截图矩阵只跑 zh/en/de/es/ru/ar，土耳其语、越南语这些更长的挡不住。 -->
                    <Grid Grid.Row="0" Margin="0,0,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:Loc System_Filter}" Style="{StaticResource Hint}" VerticalAlignment="Center" FontSize="13" Margin="2,0,10,0"/>
                            <TextBox x:Name="SSearch" Width="320" Height="30" VerticalContentAlignment="Center" TextChanged="SSearch_TextChanged"
                                     AutomationProperties.Name="{loc:Loc System_Filter}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 「默认隐藏哪些」搬进这个复选框自己的 ToolTip：用户正是悬停它时才问那个问题
                                 （与端口页两个复选框同一处理，见那边的注释）。 -->
                            <CheckBox x:Name="ShowReadOnly" Content="{loc:Loc System_ShowReadOnly}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      FontSize="12.5" Checked="ShowReadOnly_Changed" Unchecked="ShowReadOnly_Changed"
                                      ToolTip="{loc:Loc System_ShowReadOnlyTip}"/>
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource ListPanel}">
                    <DataGrid x:Name="GridSystem" AutomationProperties.Name="{loc:Loc Tab_System}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" SelectionMode="Single" PreviewMouseRightButtonDown="GridSystem_RightClick"
                              ContextMenuOpening="GridSystem_MenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="SysMenuTakeover" Header="{loc:Loc Sys_Takeover}" Click="SysTakeOver_Click"/>
                                <MenuItem x:Name="SysMenuDelete" Header="{loc:Loc Sys_Delete}" Click="SysDelete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Col_Enabled}" Width="52" HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Col_Name}" Binding="{Binding Name}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource CellEllipsis}"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Command}" Binding="{Binding Command}" Width="*" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsisMono}"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Source}" Binding="{Binding SourceLabel}" Width="Auto" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource CellEllipsis}"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Scope}" Binding="{Binding ScopeLabel}" Width="Auto" MinWidth="172" IsReadOnly="True" ElementStyle="{StaticResource CellEllipsis}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                    <TextBlock x:Name="SysLoading" Grid.Row="1" Text="{loc:Loc System_Scanning}" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <!-- 必须是 Grid（Auto|*），不能是横向 StackPanel：StackPanel 给子元素的可用宽度是无限的，
                         TextWrapping 永远不触发，说明文字直接顶出窗口右缘被裁掉。原来靠 MaxWidth="1000" 兜，
                         而窗口最窄时可用宽度只有 ~640——英语/德语/俄语的这句话实测就是在半个词处被切断。 -->
                    <!-- 与端口页同一形状（Auto|*|Auto）：页脚只留「看界面看不出来的那一件事」，
                         筛选规则进复选框的 ToolTip，「被藏了多少」由右侧计数用数字回答。
                         原来这里是三句话挤成一行——最窄窗口下要占两行，而表格正缺那两行。
                         删掉的第二句（「标『需管理员』的项需管理员身份」）不必另找地方放：
                         真去开关这种项时 SysMsg_NeedsAdmin 会把这句话在当场说一遍，那才是它该出现的时刻。 -->
                    <Grid Grid.Row="2" Margin="0,12,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="SRefresh" Content="{loc:Loc System_Refresh}" VerticalAlignment="Center" Click="SRefresh_Click"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc System_Footer}" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" x:Name="SysCount" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== 端口 ===== -->
            <TabItem x:Name="TabPorts" Header="{loc:Loc Tab_Ports}">
                <Grid Margin="2,10,2,2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- 右内边距 1px 对齐下方列表面板的右缘，理由同「系统启动项」页那处注释。
                         两栏分列（Auto | *）而不是像系统启动项页那样让两个控件叠在同一格里：
                         那边只有一个复选框，这边是两个，德语这种长译文下会直接压到 320px 的搜索框上。 -->
                    <!-- 本页借用了系统启动项页的两个键：System_Filter（「过滤」）与 System_Refresh（「刷新」）。
                         都是通用词，为两个字再开一套 18 语言的键不划算；但键名带 System_ 前缀，
                         改动前请注意它不只服务那一页——照「系统启动项」的语境去改措辞会连带改掉这里。 -->
                    <Grid Grid.Row="0" Margin="0,0,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:Loc System_Filter}" Style="{StaticResource Hint}" VerticalAlignment="Center" FontSize="13" Margin="2,0,10,0"/>
                            <TextBox x:Name="PSearch" Width="320" Height="30" VerticalContentAlignment="Center" TextChanged="PSearch_TextChanged"
                                     AutomationProperties.Name="{loc:Loc System_Filter}"/>
                        </StackPanel>
                        <!-- WrapPanel 而非横向 StackPanel：后者放不下时直接被列裁掉。
                             这两条标签在西语（Solo servicios de proyecto / Mostrar todos los puertos）
                             比德语还长一截——发现这件事正是把 es 加进截图矩阵语言轴的起因，
                             在那之前只跑 zh/en/de/ar，这一处永远是「看着没问题」。 -->
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 筛选规则放在各自的 ToolTip 里而不是底栏说明里：规则是「这个开关到底按什么认」，
                                 而人恰好是在指着这个开关时才问它。 -->
                            <CheckBox x:Name="DevOnlyPorts" Content="{loc:Loc Ports_DevOnly}" FontSize="12.5" Margin="12,0,0,0"
                                      ToolTip="{loc:Loc Ports_DevOnlyTip}" ToolTipService.ShowDuration="30000"
                                      Checked="PortsView_Changed" Unchecked="PortsView_Changed"/>
                            <CheckBox x:Name="ShowAllPorts" Content="{loc:Loc Ports_ShowAll}" FontSize="12.5" Margin="16,0,0,0"
                                      ToolTip="{loc:Loc Ports_ShowAllTip}" ToolTipService.ShowDuration="30000"
                                      Checked="PortsView_Changed" Unchecked="PortsView_Changed"/>
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource ListPanel}">
                    <DataGrid x:Name="GridPorts" AutomationProperties.Name="{loc:Loc Tab_Ports}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" SelectionMode="Single" MouseDoubleClick="GridPorts_DoubleClick"
                              PreviewMouseRightButtonDown="GridPorts_RightClick" ContextMenuOpening="GridPorts_MenuOpening">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <!-- 悬停显完整命令行：来源列只留了最后两段路径 -->
                                <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="PortMenuOpen" Header="{loc:Loc Ports_Open}" Click="PortOpen_Click"/>
                                <MenuItem x:Name="PortMenuKill" Header="{loc:Loc Ports_Kill}" Click="PortKill_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- 端口/PID/地址走等宽体：三列都是数字与点号，比例字体下同一位数字对不齐，扫一眼找不到 3000。 -->
                            <DataGridTextColumn Header="{loc:Loc Col_Port}" Binding="{Binding PortLabel}" Width="Auto" MinWidth="110" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsisMono}"/>
                            <!-- 随内容伸缩并封顶：实测下最长的就是进程名（logioptionsplus_agent、
                                 PBCCRCPassGuardXInput），写死宽度会把它们截掉；不封顶则一行奇长的名字就能把其余列挤跑。 -->
                            <DataGridTextColumn Header="{loc:Loc Col_Process}" Binding="{Binding ProcessName}" Width="Auto" MinWidth="160" MaxWidth="320" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsis}"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Pid}" Binding="{Binding PidText}" Width="Auto" MinWidth="110" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsisMono}"/>
                            <!-- 最后一列用星号吃掉尾部剩余：内容左对齐，多出来的就是尾部留白，
                                 行高亮也能铺满整行。若反过来让进程名列吃剩余，PID 和地址会被推到最右，
                                 中间空出一大片，看一行要横跨半个窗口。 -->
                            <DataGridTextColumn Header="{loc:Loc Col_Address}" Binding="{Binding Address}" Width="Auto" MinWidth="120" MaxWidth="220" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsisMono}"/>
                            <!-- 来源：命令行里的脚本/入口。光看进程名，node 和 node 分不出来，
                                 而 cdp-proxy.mjs 和 tools\serve.py 一眼就能分。放在最后并吃掉尾部剩余：
                                 它是这行里最长也最值得给地方的字段。 -->
                            <DataGridTextColumn Header="{loc:Loc Col_Source}" Binding="{Binding SourceText}" Width="*" MinWidth="140" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellEllipsis}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                    <!-- 底栏：刷新 | 两个手势 | 计数。
                         这句说明原来是 159 字一段，把九件事挤在一起（只列监听 TCP、5 秒自动刷新、双击、
                         右键连坐子进程、默认只看项目目录、按 .git 认、一进程多端口只留对外那个、
                         取消勾选看其余、勾全部则列全）。俄语 820x566 下实测占满 5 行约 90px——
                         566 高的窗口里五分之一给了没人读的说明，表格只剩 5 行可见。
                         现在只留「双击 / 右键」这两个看界面看不出来的手势；筛选规则搬进两个复选框自己的
                         ToolTip（用户正是悬停它时才问那个问题），而「被藏了多少」由右侧计数用数字直接回答。
                         Grid(Auto|*|Auto) 而非横向 StackPanel：后者给子元素无限宽度，TextWrapping 永不触发，
                         最窄窗口 + 德语/俄语这句会被顶出右缘裁掉。 -->
                    <Grid Grid.Row="2" Margin="0,12,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="PRefresh" Content="{loc:Loc System_Refresh}" VerticalAlignment="Center" Click="PRefresh_Click"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Ports_Footer}" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        <!-- 正文字体，不用等宽：这是一句带数字的话，不是表格里的数字列
                             （译文为什么不能进等宽体，见 Theme.xaml 里 FontMono 定义处那条注释）。
                             当初想用等宽挡住「每 5 秒刷新一次、数字变了宽度跟着抖」，但抖动来自位数变化
                             （4→10），等宽照样挡不住，白赔一门字形。 -->
                        <TextBlock Grid.Column="2" x:Name="PortsCount" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== 设置 ===== -->
            <TabItem Header="{loc:Loc Tab_Settings}">
                <!-- 整块面板铺满设置页：表单在上、「关于」降为页脚横条 + 右下氛围擒纵轮。
                     旧版把「关于」放在右侧独占一栏（1.3* : 1*），实测那一栏只填了自身 35% 的高度，
                     其余 65% 是空的；而左栏的三段设置装不下、要滚动，「配置备份」的按钮被底边切掉。
                     即：43% 的宽度给了填不满的内容，另外 57% 却在溢出。「关于」是读一次的静态身份，
                     不该占一整栏；把它压成页脚条，表单就拿到整幅宽度。 -->
                <Border Style="{StaticResource Card}" Margin="8,8,8,6" Padding="0" ClipToBounds="True">
                    <Grid>
                        <!-- 氛围擒纵轮：黄铜线描、右下溢出，把稀疏处填成品牌纹理而非空地。
                             用描边而非填充——实心剪影在低透明度下只剩一团发灰的色块，认不出是什么，
                             等于噪点；细线条能保住材质的色相，读作这台仪器的机构图。

                             **Data 就是 assets/logo.svg 里那条齿形路径本身**（tools/make_icon.py 的
                             mark_svg(256,16) 生成，末尾补一段轴毂圆弧），不是另画一个近似的：
                             这里曾经是第三份手抄的几何——24 齿、对称、蓝色——于是图标换成 16 齿勾齿黄铜之后，
                             同一个品牌在托盘里和设置页里是两个不同的轮子。要改形状就改那个生成器再抄过来。

                             往角外推到只露一段轮缘：实测（浅色主题、德语、1040 宽）原先那一档
                             会横穿页脚的「检查更新」按钮和右侧说明文字——留的是纹理，不是一张挡在文字前的图。 -->
                        <Path Stroke="{StaticResource BrushBrass}" StrokeThickness="1" Opacity="0.16" Stretch="Uniform" Width="440" Height="440"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-255" IsHitTestVisible="False"
                              Data="F0 M128.00,30.92 L168.71,12.06 L165.15,38.31 L209.98,36.47 L196.64,59.36 L238.77,74.81 L217.69,90.85 L250.69,121.25 L225.08,128.00 L243.94,168.71 L217.69,165.15 L219.53,209.98 L196.64,196.64 L181.19,238.77 L165.15,217.69 L134.75,250.69 L128.00,225.08 L87.29,243.94 L90.85,217.69 L46.02,219.53 L59.36,196.64 L17.23,181.19 L38.31,165.15 L5.31,134.75 L30.92,128.00 L12.06,87.29 L38.31,90.85 L36.47,46.02 L59.36,59.36 L74.81,17.23 L90.85,38.31 L121.25,5.31 Z M158.72,128.00 A30.72,30.72 0 1 0 97.28,128.00 A30.72,30.72 0 1 0 158.72,128.00 Z"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>      <!-- 设置表单 -->
                                <RowDefinition Height="Auto"/>   <!-- 分隔 -->
                                <RowDefinition Height="Auto"/>   <!-- 关于（页脚条） -->
                            </Grid.RowDefinitions>

                            <!-- 表单仍然可滚：德语/俄语的说明会多折一两行，1366×768 这类工作区下仍可能超高。
                                 靠收紧间距去躲这个高度只是把悬崖往后挪一格，滚动条才是不挑窗口大小的那个答案。 -->
                            <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource FormScroll}">
                            <!-- IsSharedSizeScope：标签列取所有行里最宽的那条并对齐，且随语言自己长。
                                 写死宽度会把德语的 Startverzögerung (s) 硬切成半个词。 -->
                            <StackPanel Margin="28,22,28,16" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                    <Border Width="3" Height="16" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Settings_Boot}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 三列表单：标签 | 控件 | 说明。
                                     说明原来是压在控件下方的段落，一页七行说明把本就装不下的竖列继续往下堆，
                                     而右边 430px 横向空间闲着。搬到右侧一列后整体高度省下约三成，
                                     宽度够时多数说明还会收成一行。
                                     控件列 MinWidth 200 让各行的说明左缘对齐；复选框上的 MaxWidth 必须下在**控件**上而不是列上——列上的只约束 Arrange，
                                     Auto 列用无限宽度测量，不封顶的话复选框里的长译文永远不换行、直接把说明挤没。 -->
                                <Grid Margin="0,2,0,4">
                                    <!-- 复选框行不参与共享尺寸组：让一个元素 ColumnSpan 跨过 SharedSizeGroup 列，
                                         它的期望宽度会反馈进共享列的计算，再触发同作用域内其它 Grid 重新测量——
                                         实测会把布局转成无限循环（截图进程烧了 1300+ 秒 CPU 停不下来，且拍出震荡中途的半宽版面）。
                                         复选框本来就从 StackPanel 的 x=0 起，与标签列左缘同一条线，不靠共享列也对齐。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="AutostartChk" MaxWidth="442" Content="{loc:Loc Autostart_Label}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Autostart_Click"/>
                                </Grid>

                                <!-- 开机延迟。「仅开机自启时生效」这句以前只在文档里，界面上看不出来，
                                     手动重跑清单时用户会以为它没生效。 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_StartupDelay}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <TextBox VerticalAlignment="Top" Grid.Column="1" x:Name="StartupDelayBox" Width="80" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center" LostFocus="Settings_Changed"
                                             AutomationProperties.Name="{loc:Loc Settings_StartupDelay}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_StartupDelayTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- 等系统就绪再跑：本来只能手改 json 才打得开（startupWaitForReady），
                                     而它恰恰是「开机延迟该设多少」的更好答案，藏起来没道理。 -->
                                <Grid Margin="0,4">
                                    <!-- 复选框行不参与共享尺寸组：让一个元素 ColumnSpan 跨过 SharedSizeGroup 列，
                                         它的期望宽度会反馈进共享列的计算，再触发同作用域内其它 Grid 重新测量——
                                         实测会把布局转成无限循环（截图进程烧了 1300+ 秒 CPU 停不下来，且拍出震荡中途的半宽版面）。
                                         复选框本来就从 StackPanel 的 x=0 起，与标签列左缘同一条线，不靠共享列也对齐。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="WaitReadyChk" MaxWidth="442" Content="{loc:Loc Settings_WaitReady}" VerticalAlignment="Top" Click="Settings_Changed"/>
                                    <!-- 说明在第 1 列（这一行只有 0、1 两列）。此前写的是 Grid.Column="2"，
                                         越界的列号被 WPF 夹到最后一列，看着是对的——纯属侥幸，不是设计。 -->
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Settings_WaitReadyTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <Grid Margin="0,4,0,2">
                                    <!-- 复选框行不参与共享尺寸组：让一个元素 ColumnSpan 跨过 SharedSizeGroup 列，
                                         它的期望宽度会反馈进共享列的计算，再触发同作用域内其它 Grid 重新测量——
                                         实测会把布局转成无限循环（截图进程烧了 1300+ 秒 CPU 停不下来，且拍出震荡中途的半宽版面）。
                                         复选框本来就从 StackPanel 的 x=0 起，与标签列左缘同一条线，不靠共享列也对齐。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="StartMinChk" MaxWidth="442" Content="{loc:Loc Settings_StartMinimized}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Settings_Changed"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BrushLine}" Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,11">
                                    <Border Width="3" Height="16" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Settings_General}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 急停键（点击即录键） -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_StopHotkey}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <TextBox VerticalAlignment="Top" Grid.Column="1" x:Name="HotkeyBox" Width="190" Height="32" HorizontalAlignment="Left" Style="{StaticResource HotkeyCapture}"
                                             AutomationProperties.Name="{loc:Loc Settings_StopHotkey}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_HotkeyCaptureTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>



                                <!-- 语言 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Language}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <ComboBox VerticalAlignment="Top" Grid.Column="1" x:Name="LangCombo" Width="170" Height="30" HorizontalAlignment="Left" SelectionChanged="Lang_Changed"
                                              AutomationProperties.Name="{loc:Loc Settings_Language}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_LangRestart}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- 主题紧跟语言：两者都是「这个程序看起来 / 读起来是什么样」，
                                     而且是设置页里仅有的两个当场改变整个界面的开关。 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Theme}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <ComboBox VerticalAlignment="Top" Grid.Column="1" x:Name="ThemeCombo" Width="170" Height="30" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"
                                              AutomationProperties.Name="{loc:Loc Settings_Theme}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_ThemeTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- 配置导入/导出并进「常规」：它只有一行两个按钮，
                                     单独开一节要搭上强调色标记 + 显示字体标题 + 一条分隔线，这层 chrome 没挣到它占的位置。
                                     WrapPanel 而非横向 StackPanel：后者给子元素无限宽度，放不下就被裁——
                                     这两条标签中文 4 字、德语 25 字（Konfiguration exportieren），实测 1040 宽下都并不下。 -->
                                <!-- 与上面各行同为三列，说明左缘才对得齐（此前它只有两列，说明缺位，
                                     右侧那一列在这一行上是断的）。
                                     补说明的理由：这是「常规」里唯一会**覆盖**你现有配置的操作，
                                     偏偏又是唯一一行什么都没写的。 -->
                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Backup}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <!-- MaxWidth 必须落在 WrapPanel 自己身上，光写在列上不管用：
                                         Width="Auto" 的列是按**无限宽**去测量子元素的，WrapPanel 于是报出
                                         「一行排得下」，随后才被列夹到 330——排好的那一行不会重排，只会被裁。
                                         德语下「Konfiguration importieren」正是这么被切在词中间的。
                                         （面板底部那排自带操作栽过同一个跟头，见 PanelMetrics.GridWidth。） -->
                                    <WrapPanel Grid.Column="1" MaxWidth="330">
                                        <Button VerticalAlignment="Top" x:Name="ExportBtn" Content="{loc:Loc Btn_ExportConfig}" Click="ExportConfig_Click" Margin="0,0,10,6"/>
                                        <Button VerticalAlignment="Top" x:Name="ImportBtn" Content="{loc:Loc Btn_ImportConfig}" Click="ImportConfig_Click" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_BackupTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- ===== 快捷面板 =====
                                     单独开一节而不是塞进「常规」：这里有六项，且全都只影响那一个浮层——
                                     混在急停键、语言、导入导出中间时，读的人分不出哪几行是一伙的。
                                     顺序按「先怎么叫出来、再长什么样」：两项呼出方式，四项外观。 -->
                                <Border Height="1" Background="{StaticResource BrushLine}" Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,11">
                                    <Border Width="3" Height="16" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Settings_Panel}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 总开关，摆在本节最前面。勾掉之后下面两行一起收起来——
                                     它们此刻控制不了任何东西，留着就是「看着能填、填了不生效」
                                     （同 UpdateOnYes / UpdateSysRows 那条立场）。 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="PanelEnabledChk" MaxWidth="442" Content="{loc:Loc Settings_UsePanel}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" Click="Settings_Changed"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Settings_UsePanelTip}" Style="{StaticResource FieldHint}"
                                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,2,0,0"/>
                                </Grid>

                                <!-- 面板热键（点击即录键） -->
                                <Grid x:Name="PanelHotkeyRow" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" SharedSizeGroup="SetLabel"/>
                                        <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_PanelHotkey}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <TextBox VerticalAlignment="Top" Grid.Column="1" x:Name="PanelHotkeyBox" Width="190" Height="32" HorizontalAlignment="Left" Style="{StaticResource HotkeyCapture}"
                                             AutomationProperties.Name="{loc:Loc Settings_PanelHotkey}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_PanelHotkeyTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- 中键长按唤面板：复选框 + 长按毫秒。默认关（理由见 AppSettings.PanelMiddleLongPress）。
                                     阈值框紧跟在复选框后面而不是另起一行：它只在勾上之后才有意义，
                                     离得远了会变成一个「看着能填、填了不知道管什么」的孤立数字。 -->
                                <Grid x:Name="PanelMiddleRow" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="MiddleLongPressChk" MaxWidth="442" Content="{loc:Loc Settings_MiddleLongPress}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Settings_Changed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0">
                                        <TextBox VerticalAlignment="Top" x:Name="LongPressMsBox" Width="62" Height="28" AutomationProperties.Name="{loc:Loc Settings_LongPressMs}" LostFocus="Settings_Changed"/>
                                        <TextBlock Text="{loc:Loc Unit_Ms}" Style="{StaticResource FieldHint}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings_MiddleLongPressTip}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,6,0,0"/>
                                </Grid>

                                <!-- 外观：每行格子数 + 格子尺寸并作一行。两者一起决定面板多宽多密，
                                     分两行会让人以为它们互不相干、各调一个。 -->

                                <!-- ===== 鼠标手势 =====
                                     和快捷面板并列成一节：它们是这个程序里唯二「要占用鼠标」的功能，
                                     而用户要做的判断是同一个——用不用。此前手势的总开关只在手势管理器
                                     标题行里，那扇窗要从动作页侧栏进去才看得到，于是「我不想让它碰我的右键」
                                     这件事在设置页里压根找不到，只能靠逐条取消勾选。
                                     这一节只有总开关：手势本身怎么配还是在管理器里（那里有画板），
                                     设置页要回答的只是「要不要用」。 -->
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                                    <Border Width="3" Height="16" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Gesture_Manager}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="442"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="GesturesEnabledChk" MaxWidth="442" Content="{loc:Loc Settings_UseGestures}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" Click="Settings_Changed"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Settings_UseGesturesTip}" Style="{StaticResource FieldHint}"
                                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,2,0,0"/>
                                </Grid>


                            </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource BrushLine}" Margin="28,0"/>

                            <!-- ===== 关于：页脚横条 =====
                                 一次读完的静态身份，横着一条就够；原来它独占右侧 43% 的宽度，
                                 只填了那一栏 35% 的高度。Grid(Auto|*|Auto) 而非横向 StackPanel：
                                 后者给子元素无限宽度，副标题的 TextWrapping 永远不生效，窄窗口下直接被裁
                                 （英语实测被切成「Startup · Reminders · One-tap Actio」）。 -->
                            <Grid Grid.Row="2" Margin="28,12,28,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/logo-256.png" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Clockwork" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="VersionText" Foreground="{StaticResource BrushMuted}" FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                        <!-- 这一行原来是写死的中文，18 种语言的界面里都印着「365 开源计划」 -->
                                        <TextBlock Text="{loc:Loc About_Series}" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="16,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc App_Subtitle}" Foreground="{StaticResource BrushMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="GitHub" Click="GitHub_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="CheckUpdateBtn" Content="{loc:Loc About_CheckUpdate}" Style="{StaticResource RunButton}" Click="CheckUpdate_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </local:StripTabControl>
    </Grid>
</Window>
