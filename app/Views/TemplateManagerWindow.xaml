<Window x:Class="Clockwork.Views.TemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc TplMgr_Title}" Width="720" Height="560" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushInk}" ShowInTaskbar="False">
    <!-- 模板管理器。存在的理由：模板此前只能「添加为新动作」——点了立刻开动作编辑器，
         存下来的那份改完就成了普通动作，**模板本身动不了**。
         于是「逐行输入」这类交互式模板一旦不合手（变量名想换、想少一步）就只能整个照抄一份再改，
         而下一次添加还是原样那个。改过的模板存在 RootConfig.Templates，按内置模板的 key 认领。

         与动作编辑器的分工：这里管「模板长什么样」，改它要按「修改模板」进动作编辑器；
         「添加为新动作」则是把模板**复制**一份成普通动作——那一份从此与模板无关，
         这正是模板该有的语义（同 Quicker 的分享动作：装下的是一份副本）。 -->
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc TplMgr_Hint}" Style="{StaticResource FieldHint}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource ListPanel}">
            <Grid>
                <ListBox x:Name="List" AutomationProperties.Name="{loc:Loc TplMgr_Title}"
                         Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="List_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标走 IconVisual（与面板格子、三个编辑器里的预览块同一条路），
                                     而不是把码位当字符画。码位在 Segoe MDL2 Assets 的私用区，
                                     不钉那套字体就是一块豆腐——精简 SKU 上那块字形可能压根没装，
                                     十个模板就变成十个空框，一个都认不出。
                                     图标元素在行构造时就画好（十行，不做虚拟化）。 -->
                                <ContentControl Grid.Column="0" Content="{Binding Icon}" Width="26"
                                                VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource KindChip}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="{loc:Loc TplMgr_Empty}" Style="{StaticResource Hint}"
                           Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="AddBtn" Content="{loc:Loc TplMgr_Add}" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="Add_Click"/>
            <Button x:Name="EditBtn" Content="{loc:Loc TplMgr_Edit}" Padding="14,5" Margin="8,0,0,0" Click="Edit_Click"/>
            <Button x:Name="ResetBtn" Content="{loc:Loc TplMgr_Reset}" Style="{StaticResource DangerButton}" Padding="14,5" Margin="8,0,0,0" Click="Reset_Click"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Padding="14,5" Margin="24,0,0,0" Click="Close_Click" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
