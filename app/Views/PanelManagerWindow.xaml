<Window x:Class="Clockwork.Views.PanelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Panel_Manager}" Width="1180" Height="700" MinWidth="860" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushInk}">
    <!-- 面板管理器：**它长得就是那个面板，只是可以编辑**。
         左栏选**场景**（全局 / 每个程序），顶栏选**分类**，右边把这一组下的**所有页并排**摆出来
         ——照 Quicker 的「场景与动作管理」：左一列场景（带应用自己的图标），右一片动作页卡片。

         为什么左栏从「页」换成「场景」：左栏原来列的是页，于是「绑给哪个程序」这件事只活在
         页眉那一颗按钮上，一屏十几个页就是十几个 `code.exe` `Code.exe` 的等宽字符串。
         而「在 VS Code 里弹出来和在资源管理器里弹出来不该是同一批动作」是面板最值钱的一条规则，
         它值得占左栏第一等公民——**改的是左栏里那一列的顺序，而不是一颗按钮上的字段**。

         分类这一维**不让位**：它与场景是两件事（一页 = 类别 × 场景）。Quicker 只有场景，
         那是它的动作库组织方式不同，不是它更高明。所以两条导航都在，各管一维。 -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- 顶部分类栏 + 当前这一组的页 -->
            <RowDefinition Height="Auto"/>   <!-- 外观控制条 -->
            <RowDefinition Height="Auto"/>   <!-- 底栏 -->
        </Grid.RowDefinitions>

        <!-- ── 页：**长成面板的样子** ──
             一条顶栏 + 一条左栏 + 当前那一页，位置与 QuickPanelWindow 一一对应，
             连页签用的都是同两个样式（PanelTopTab / PanelPageTab）。

             此前是把该场景下所有页的格子阵一次全铺出来、纵向滚。那个布局的理由是
             「决定哪个动作放哪一页时得同时看见所有页」——可代价是这扇窗不再像面板：
             四页就是四堵七行的格子墙，滚两屏才看得完，而面板上你一次只看见一页。
             页签把这两件事同时办了：所有页的**名字**始终在眼前（归属一眼可见），
             而格子只画当前这一页。要把一个动作挪到别页，拖到那一页的页签上放手即可。 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 顶栏压在最上面并跨满两列，左栏在它下面——与面板同一个几何关系。 -->
            <!-- 与面板同一条基线（说明见 QuickPanelWindow.xaml）。 -->
            <Border x:Name="TopTabRow" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
                <WrapPanel x:Name="TopTabBar" AutomationProperties.Name="{loc:Loc Panel_Category}"/>
            </Border>
            <ScrollViewer x:Name="RailScroll" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 筛选框。场景多了以后左栏要滚，而「我要找绑在 VS Code 上的那一页」这件事
                         不该靠滚动完成。空 = 不过滤。 -->
                    <TextBox x:Name="SceneFilterBox" AutomationProperties.Name="{loc:Loc Panel_Filter}"
                             Height="28" Margin="0,0,0,8" ToolTip="{loc:Loc Panel_FilterTip}"
                             TextChanged="SceneFilterBox_TextChanged"/>
                    <StackPanel x:Name="PageRail" AutomationProperties.Name="{loc:Loc Panel_Scenes}"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{loc:Loc Panel_Pages}">
                <!-- 横排：这一组下的**所有页并排**（照 Quicker 的动作页卡片）。
                     居中只在放得下时成立——放不下时左对齐并出横向滚动条，
                     居中 + 横向滚动条会把最左边那页推到视野外，而它恰恰是你刚建的那一页。 -->
                <StackPanel x:Name="Pages" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>

        <!-- ── 底：新增与关闭 ── -->
        <!-- 面板的外观：**放在能看见它的地方**。
             这四项（版面 / 格子尺寸 / 只显示图标 / 显示自带操作）原来在设置页，
             而它们是纯视觉选择 —— 光看下拉判断不了，只能靠「改 → 关设置 → 按热键 → 看 → 再改」盲调。
             这个窗口本来就是面板的所见即所得预览，改一下、预览重画、当场看到。

             为什么不放进面板本身：面板刻意是一次性的（失焦即关、Esc 即关、点一格先关自己再执行），
             放设置进去要给这三条关闭路径逐条开例外，而「面板一定会自己消失」这个保证
             比就地调设置值钱得多 —— 它是浮在所有窗口之上的，关不掉才是真事故。
             呼出方式（面板键、长按中键）留在设置页：那是记忆与冲突问题，不是看得见的问题。 -->
        <Border Grid.Row="1" Background="{StaticResource BrushSlate}" BorderBrush="{StaticResource BrushLine}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <WrapPanel>
                <TextBlock Text="{loc:Loc Settings_PanelLayout}" Style="{StaticResource FieldHint}" VerticalAlignment="Bottom"
                           Margin="0,0,10,6" ToolTip="{loc:Loc Settings_PanelLayoutTip}"/>
                <!-- 读作「4 列 × 上 3 行 + 下 4 行」：符号本身就是这个几何关系，且不需要翻译。
                     符号留下，但每个下拉各自带一个微型字段名——光看「4 × 3 + 4」，
                     三个数字里哪个是列、哪个是上带，要点开 ToolTip 才知道，而那一步没人会做。
                     名字用的就是三个下拉本来就带着的朗读名（同一批键，不多一份文案）。 -->
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:Loc Settings_PanelColumns}" Style="{StaticResource FieldMicroLabel}"/>
                    <ComboBox x:Name="PanelColumnsCombo" Width="58" Height="28" SelectionChanged="Look_Changed"
                              ToolTip="{loc:Loc Settings_PanelLayoutTip}"
                              AutomationProperties.Name="{loc:Loc Settings_PanelColumns}"/>
                </StackPanel>
                <TextBlock Text="×" Style="{StaticResource FieldHint}" VerticalAlignment="Bottom" Margin="6,0,6,8"/>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:Loc Settings_PanelTopRows}" Style="{StaticResource FieldMicroLabel}"/>
                    <ComboBox x:Name="PanelTopRowsCombo" Width="54" Height="28" SelectionChanged="Look_Changed"
                              ToolTip="{loc:Loc Settings_PanelLayoutTip}"
                              AutomationProperties.Name="{loc:Loc Settings_PanelTopRows}"/>
                </StackPanel>
                <TextBlock Text="+" Style="{StaticResource FieldHint}" VerticalAlignment="Bottom" Margin="6,0,6,8"/>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:Loc Settings_PanelBottomRows}" Style="{StaticResource FieldMicroLabel}"/>
                    <ComboBox x:Name="PanelBottomRowsCombo" Width="54" Height="28" SelectionChanged="Look_Changed"
                              ToolTip="{loc:Loc Settings_PanelLayoutTip}"
                              AutomationProperties.Name="{loc:Loc Settings_PanelBottomRows}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="14,0,0,0">
                    <TextBlock Text="{loc:Loc Settings_PanelTileSize}" Style="{StaticResource FieldMicroLabel}"/>
                    <ComboBox x:Name="PanelTileSizeCombo" Width="100" Height="28" SelectionChanged="Look_Changed"
                              AutomationProperties.Name="{loc:Loc Settings_PanelTileSize}"/>
                </StackPanel>
                <CheckBox x:Name="PanelIconOnlyChk" Content="{loc:Loc Settings_PanelIconOnly}" VerticalAlignment="Center" Margin="18,0,0,0"
                          ToolTip="{loc:Loc Settings_PanelIconOnlyTip}" Click="Look_Changed"/>
                <CheckBox x:Name="PanelShowOpsChk" Content="{loc:Loc Settings_PanelShowOps}" VerticalAlignment="Center" Margin="18,0,0,0" Click="Look_Changed"/>
                <!-- 两条导航栏的开关。它们**空着本来就不画**（只有一页没有页签栏、只有一类没有分类栏），
                     所以这两个勾的实际用途是「我知道有好几页，但我就是不想看见那条栏」。 -->
                <CheckBox x:Name="PanelLeftTabsChk" Content="{loc:Loc Panel_ShowLeftTabs}" VerticalAlignment="Center" Margin="18,0,0,0"
                          ToolTip="{loc:Loc Panel_BarsHint}" Click="Look_Changed"/>
                <CheckBox x:Name="PanelTopTabsChk" Content="{loc:Loc Panel_ShowTopTabs}" VerticalAlignment="Center" Margin="18,0,0,0"
                          ToolTip="{loc:Loc Panel_BarsHint}" Click="Look_Changed"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- 这里曾经有一颗「添加面板页」。两条栏各自末尾都有「+」之后它就是第二个入口了，
                 而且在窗口另一头——你正看着左栏，按钮却在这儿。删掉。 -->
            <!-- 直接放进 * 列，不套 WrapPanel：**WrapPanel 给子元素的可用宽度是无限的**，
                 于是 TextWrapping 永不触发，只能靠 MaxWidth 兜——而 820 宽下 * 列减掉「关闭」
                 就只剩 ~600，写死的 MaxWidth="700" 会让这句话钻到按钮底下（实测：末尾「右键页签…」
                 被按钮压掉）。交给 * 列量宽度，换行才真的会发生。
                 与端口 / 系统启动项两处页脚同一条处理，那边的注释记着同一个坑。
                 这四句话不精简：它们教的全是拖拽手势——看界面看不出来的那一类，正该留在页脚。 -->
            <!-- 清空点击统计。只在有数据时出现（App 传进来的字典为空就是隐藏）。
                 **它必须占自己的列**：曾和指路文案同放 * 列右对齐，于是文案的第二行
                 直接从按钮底下穿过去（用户实报「底部叠在一起了」——有统计数据时才现形，
                 默认配置的截图永远截不到）。列一独立，* 列自动让宽，换行点自己会算。 -->
            <TextBlock Grid.Column="0" Text="{loc:Loc Panel_ManagerHint}" Style="{StaticResource FieldHint}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Grid.Column="1" x:Name="ResetUsageBtn" Content="{loc:Loc Btn_ResetUsage}" Height="32"
                    MinWidth="104" Margin="0,0,12,0" Click="ResetUsage_Click" Visibility="Collapsed" ToolTip="{loc:Loc Btn_ResetUsageTip}"/>
            <Button Grid.Column="2" Content="{loc:Loc Btn_Close}" MinWidth="88" Height="32" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
