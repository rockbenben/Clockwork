<Window x:Class="Clockwork.Views.StepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Ed_Title_Step}" Width="560" SizeToContent="Height" MaxHeight="392" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushInk}"
        ShowInTaskbar="False" MinWidth="480" MinHeight="340">
    <!-- 右边距 6 不是 16：滚动条贴的是这层 Grid 的右缘，边距给大了它就悬在内容区里「靠左」，
         还把最宽的行(118+10+380=508)挤进滚动条底下。内容与滚动条的间隙由 FormScroll 的内缩负责。 -->
    <Grid Margin="16,16,6,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc Ed_Type}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="KindCombo" AutomationProperties.Name="{loc:Loc Ed_Type}" Width="240" Height="28" SelectionChanged="KindCombo_Changed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource FormScroll}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{loc:Loc Ed_Label}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="LabelBox" AutomationProperties.Name="{loc:Loc Ed_Label}" Width="380" Height="28"/>
                </StackPanel>
                <!-- 面板图标：紧跟标签，两者回答的是同一个问题——这一步在面板上长什么样。
                     留空即自动（「运行程序」取目标自己的图标，其余按类型用线描字形），
                     所以绝大多数人永远不必碰它。 -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{loc:Loc Ed_Icon}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <!-- 画的是**这一步最后会长什么样**，不是配置里存的那串码位/路径：
                         留空时它显示自动取到的那个（「运行程序」会取目标程序自己的图标），
                         于是「大多数人不必碰它」这句话有了当场可验的证据，而不是一句承诺。 -->
                    <Button x:Name="IconBtn" Width="46" Height="38" ContentTemplate="{x:Null}"
                            ToolTip="{loc:Loc Icon_Pick}" AutomationProperties.Name="{loc:Loc Icon_Pick}"
                            Click="BrowseIcon_Click"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc Ed_IconHint}" Foreground="{StaticResource BrushMuted}" FontSize="12"
                           TextWrapping="Wrap" Margin="118,0,0,4"/>

                <StackPanel x:Name="PanApp">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Target}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="TargetBox" AutomationProperties.Name="{loc:Loc Ed_Target}" Width="300" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="8,0,0,0" Click="BrowseTarget_Click"/><Button x:Name="TargetVarBtn" Style="{StaticResource PickerButton}" Content="{}{ }" ToolTip="{loc:Loc Btn_InsertVar}" AutomationProperties.Name="{loc:Loc Btn_InsertVar}" Margin="6,0,0,0" Click="PickTargetVar_Click"/></StackPanel>
                    <TextBlock x:Name="TargetPreview" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4" Visibility="Collapsed"/>
                    <TextBlock Text="{loc:Loc Ed_AppHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Args}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="ArgsBox" AutomationProperties.Name="{loc:Loc Ed_Args}" Width="380" Height="28"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_WorkDir}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="WorkDirBox" AutomationProperties.Name="{loc:Loc Ed_WorkDir}" Width="300" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="8,0,0,0" Click="BrowseWorkDir_Click"/><Button x:Name="WorkDirVarBtn" Style="{StaticResource PickerButton}" Content="{}{ }" ToolTip="{loc:Loc Btn_InsertVar}" AutomationProperties.Name="{loc:Loc Btn_InsertVar}" Margin="6,0,0,0" Click="PickWorkDirVar_Click"/></StackPanel>
                    <TextBlock x:Name="WorkDirPreview" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4" Visibility="Collapsed"/>
                    <CheckBox x:Name="ElevatedChk" Content="{loc:Loc Ed_Elevated}" Margin="118,3,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_WindowStyle}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="WinStyleCombo" AutomationProperties.Name="{loc:Loc Ed_WindowStyle}" Width="240" Height="28"/></StackPanel>
                    <CheckBox x:Name="ActivateChk" Content="{loc:Loc Ed_ActivateIfRunning}" Margin="118,3,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_ActivateProcess}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="ActivateProcBox" AutomationProperties.Name="{loc:Loc Ed_ActivateProcess}" Width="300" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Pick}" AutomationProperties.Name="{loc:Loc Btn_Pick}" Margin="8,0,0,0" Click="PickActivateProc_Click"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AltTargets}" Width="108" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="AltTargetsBox" AutomationProperties.Name="{loc:Loc Ed_AltTargets}" Width="380" Height="52" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_AltTargetsHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanKeys">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Combo}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="ComboBox2" AutomationProperties.Name="{loc:Loc Ed_Combo}" Width="300" Height="28" Style="{StaticResource HotkeyCapture}"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_KeysHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanMouse">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Action}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="MouseActCombo" AutomationProperties.Name="{loc:Loc Ed_Action}" Width="240" Height="28"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_MouseHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanVolume">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Action}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="VolActionCombo" AutomationProperties.Name="{loc:Loc Ed_Action}" Width="240" Height="28" SelectionChanged="VolAction_Changed"/></StackPanel>
                    <StackPanel x:Name="VolLevelRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Level}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="LevelBox" AutomationProperties.Name="{loc:Loc Ed_Level}" Width="90" Height="28"/></StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanWindow">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Action}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="WinActionCombo" AutomationProperties.Name="{loc:Loc Ed_Action}" Width="240" Height="28" SelectionChanged="WinAction_Changed"/></StackPanel>
                    <StackPanel x:Name="WinProcRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Process}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="ProcessBox" AutomationProperties.Name="{loc:Loc Ed_Process}" Width="240" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Pick}" AutomationProperties.Name="{loc:Loc Btn_Pick}" Margin="8,0,0,0" Click="PickProcess_Click"/></StackPanel>
                    <TextBlock x:Name="WinProcHint" Text="{loc:Loc Ed_ProcessHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,0"/>
                    <TextBlock x:Name="WinHint" Text="{loc:Loc Ed_WindowHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                    <!-- 「恢复活动窗口」只在这一档出现：它是这张下拉里唯一不填目标的一条，
                         而一个什么都不用填的面板，看着像是没加载出来。这句话就是它的说明书。 -->
                    <TextBlock x:Name="WinRestoreHint" Text="{loc:Loc Ed_RestoreHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,4,0,4"/>
                    <TextBlock x:Name="WinTopmostHint" Text="{loc:Loc Ed_TopmostHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                    <StackPanel x:Name="WinSendRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_SendKey}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="SendKeyBox" AutomationProperties.Name="{loc:Loc Ed_SendKey}" Width="240" Height="28"/><Button Content="{loc:Loc Btn_Capture}" MinWidth="72" Height="28" Padding="10,0" Margin="8,0,0,0" Click="CaptureSendKey_Click"/></StackPanel>
                    <StackPanel x:Name="WinWaitRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_WaitWin}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="WaitWinBox" AutomationProperties.Name="{loc:Loc Ed_WaitWin}" Width="90" Height="28"/></StackPanel>
                    <StackPanel x:Name="WinPostRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_PostDelay}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="PostDelayBox" AutomationProperties.Name="{loc:Loc Ed_PostDelay}" Width="90" Height="28"/></StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanSystem">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Command}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="SysCmdCombo" AutomationProperties.Name="{loc:Loc Ed_Command}" Width="240" Height="28" SelectionChanged="SysCmd_Changed"/></StackPanel>
                    <!-- 只有带参数的命令才露出这几行（搜索引擎 / 剪贴板文本 / 亮度），其余命令一格空框都不出现 -->
                    <StackPanel x:Name="SysEngineRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_SearchEngine}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="SysEngineCombo" AutomationProperties.Name="{loc:Loc Ed_SearchEngine}" Width="240" Height="28" SelectionChanged="SysEngine_Changed"/></StackPanel>
                    <StackPanel x:Name="SysTextRow" Orientation="Horizontal" Margin="0,3"><TextBlock x:Name="SysTextLabel" Text="{loc:Loc Ed_ClipText}" Width="108" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="SysTextBox" AutomationProperties.Name="{loc:Loc Ed_ClipText}" Width="380" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                    <TextBlock x:Name="SysTextHint" Text="{loc:Loc Ed_SearchUrlHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                    <StackPanel x:Name="SysLevelRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Brightness}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="SysLevelBox" AutomationProperties.Name="{loc:Loc Ed_Brightness}" Width="90" Height="28"/><TextBlock Text="{loc:Loc Ed_BrightnessHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                </StackPanel>

                <!-- 打开网址：只有一个地址框。它从「运行程序」拆出来，就是为了不再让人在一个
                     写着「目标（程序 / 快捷方式 / 脚本 / 文件夹 / 网址…）」的框里找网址那一档。 -->
                <StackPanel x:Name="PanUrl">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Url}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="UrlBox" AutomationProperties.Name="{loc:Loc Ed_Url}" Width="380" Height="28"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_UrlHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <!-- 打开文件或文件夹：与「打开网址」对称的一档——从「运行程序」拆出来，只剩一个路径框。
                     浏览按钮文件、文件夹都能挑（先弹文件框，取消再弹文件夹框，与条件里「路径存在」同一个挑法）。 -->
                <StackPanel x:Name="PanPath">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Path}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="PathBox" AutomationProperties.Name="{loc:Loc Ed_Path}" Width="300" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="8,0,0,0" Click="BrowsePath_Click"/><Button x:Name="PathVarBtn" Style="{StaticResource PickerButton}" Content="{}{ }" ToolTip="{loc:Loc Btn_InsertVar}" AutomationProperties.Name="{loc:Loc Btn_InsertVar}" Margin="6,0,0,0" Click="PickPathVar_Click"/></StackPanel>
                    <TextBlock x:Name="PathPreview" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4" Visibility="Collapsed"/>
                    <TextBlock Text="{loc:Loc Ed_PathHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanCopySelection">
                    <TextBlock Text="{loc:Loc Ed_CopySelectionHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,4,0,4"/>
                </StackPanel>

                <!-- 用户输入：问一句、收一段文字。提示语就是弹框上那句话，所以它才是这一步的身份，
                     摆在第一行；默认值是可选的便利（想改直接敲，想用回车即走）。 -->
                <StackPanel x:Name="PanPrompt">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AskText}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="AskTextBox" AutomationProperties.Name="{loc:Loc Ed_AskText}" Width="380" Height="28"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AskDefault}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="AskDefaultBox" AutomationProperties.Name="{loc:Loc Ed_AskDefault}" Width="380" Height="28"/></StackPanel>
                </StackPanel>

                <!-- 用户选择：一行一个选项。多行框的形状本身就在说「一行一个」，
                     比在旁边写一句「用逗号分隔」可靠——而选项里出现逗号是常态。 -->
                <StackPanel x:Name="PanChoice">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AskText}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="ChoiceTextBox" AutomationProperties.Name="{loc:Loc Ed_AskText}" Width="380" Height="28"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Options}" Width="108" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="OptionsBox" AutomationProperties.Name="{loc:Loc Ed_Options}" Width="380" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_OptionsHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <!-- 「输出到变量」——三种会产出值的类型共用这一行（用户输入 / 用户选择 / 获取选中的文字）。
                     它不属于任何一个类型的面板：三处各放一份，改一次说明就得改三处。
                     说明行把「怎么用它」也讲了，因为**光有一个变量名，用户不会知道下一步该怎么引用它**。 -->
                <StackPanel x:Name="PanOutputVar">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_OutputVar}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="OutputVarBox" AutomationProperties.Name="{loc:Loc Ed_OutputVar}" Width="240" Height="28"/></StackPanel>
                    <TextBlock x:Name="OutputVarHint" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanWaitClipboard">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_WaitSeconds}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="WaitSecondsBox" AutomationProperties.Name="{loc:Loc Ed_WaitSeconds}" Width="90" Height="28"/></StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanText">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Text}" Width="108" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="TextBox2" AutomationProperties.Name="{loc:Loc Ed_Text}" Width="380" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_TextProcess}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="TextProcessBox" AutomationProperties.Name="{loc:Loc Ed_TextProcess}" Width="240" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Pick}" AutomationProperties.Name="{loc:Loc Btn_Pick}" Margin="8,0,0,0" Click="PickTextProcess_Click"/></StackPanel>
                    <TextBlock Text="{loc:Loc Ed_TextHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PanMessage">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Message}" Width="108" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="MessageBox2" AutomationProperties.Name="{loc:Loc Ed_Message}" Width="380" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Present}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="PresentCombo" AutomationProperties.Name="{loc:Loc Ed_Present}" Width="240" Height="28" SelectionChanged="Present_Changed"/></StackPanel>
                    <CheckBox x:Name="SpeakChk" Content="{loc:Loc Ed_Speak}" Margin="118,3,0,3"/>
                    <StackPanel x:Name="MsgCardRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AutoDismiss}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="PopupSecondsBox" AutomationProperties.Name="{loc:Loc Ed_AutoDismiss}" Width="90" Height="28"/></StackPanel>
                    <CheckBox x:Name="ConfirmChk" Content="{loc:Loc Ed_Confirm}" Margin="118,3,0,3"/>
                    <StackPanel x:Name="MsgOnYesRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_OnYes}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="OnYesTypeCombo" AutomationProperties.Name="{loc:Loc Ed_OnYes}" Width="140" Height="28" SelectionChanged="OnYesType_Changed"/><TextBox x:Name="OnYesTargetBox" AutomationProperties.Name="{loc:Loc Ed_OnYes}" Width="150" Height="28" Margin="8,0,0,0"/><Button x:Name="OnYesBrowseBtn" Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="8,0,0,0" Click="BrowseOnYes_Click"/></StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanGroup">
                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Group}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="GroupCombo" AutomationProperties.Name="{loc:Loc Ed_Group}" Width="240" Height="28"/></StackPanel>
                    <!-- 交叉口指路：一个组都没有时，下拉里只有「（无）」，是条死路——告诉人出口在哪，
                         而不是让他对着空下拉猜。只在真没有组时出现（见构造函数）。 -->
                    <!-- 选中组的内容预览：只有名字答不出「我选对了吗」。 -->
                    <TextBlock x:Name="GroupPeek" Foreground="{StaticResource BrushFaint}" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               HorizontalAlignment="Left" Margin="118,2,0,4"/>
                    <TextBlock x:Name="NoGroupsHint" Text="{loc:Loc Ed_NoGroupsHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{loc:Loc Ed_DelayMs}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="DelayBox" AutomationProperties.Name="{loc:Loc Ed_DelayMs}" Width="120" Height="28"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Note}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="NoteBox" AutomationProperties.Name="{loc:Loc Ed_Note}" Width="380" Height="28"/></StackPanel>

                <!-- 条件与重复整块折叠。新用户加一条「打开微信」不必面对六种条件和重复次数——
                     没配置时默认收起、一行「总是执行」带过；配过的自动展开。折叠条标题由代码实时填
                     （UpdateCondHeader），用的是列表摘要同一套文案，编辑时看到的与列表里看到的严格一致。
                     原来的分隔线让位给折叠条本身：强调色箭头 + 左缘齐平，同样读作「换了一段」。 -->
                <Expander x:Name="CondExp" Margin="0,14,0,0">
                <StackPanel Margin="0,4,0,0">
                <StackPanel x:Name="RepeatRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Repeat}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="RepeatBox" AutomationProperties.Name="{loc:Loc Ed_Repeat}" Width="120" Height="28"/></StackPanel>
                <TextBlock Text="{loc:Loc Ed_DaysHeader}" Margin="0,8,0,6" FontSize="12" Foreground="{StaticResource BrushMuted}"/>
                <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="Day1" Content="{loc:Loc Day_1}" Margin="0,0,10,0"/><CheckBox x:Name="Day2" Content="{loc:Loc Day_2}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="Day3" Content="{loc:Loc Day_3}" Margin="0,0,10,0"/><CheckBox x:Name="Day4" Content="{loc:Loc Day_4}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="Day5" Content="{loc:Loc Day_5}" Margin="0,0,10,0"/><CheckBox x:Name="Day6" Content="{loc:Loc Day_6}" Margin="0,0,10,0"/><CheckBox x:Name="Day7" Content="{loc:Loc Day_7}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <CheckBox x:Name="OnlyBeforeChk" Content="{loc:Loc Ed_OnlyBefore}" VerticalAlignment="Center"/>
                    <!-- 朗读名用整句格式说明，不用左边那个「仅」——「仅」单独念出来什么也不是 -->
                    <TextBox x:Name="BeforeTimeBox" AutomationProperties.Name="{loc:Loc Ed_BeforeTimeHint}" Width="60" Height="26" Margin="6,0" ToolTip="{loc:Loc Ed_BeforeTimeHint}"/>
                    <TextBlock Text="{loc:Loc Ed_HourBefore}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 「仅 N 后」与上面一行是 AND：两条都勾 = 09:00 后且 18:00 前，正好圈出上班时段 -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <CheckBox x:Name="OnlyAfterChk" Content="{loc:Loc Ed_OnlyAfter}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AfterTimeBox" AutomationProperties.Name="{loc:Loc Ed_AfterTimeHint}" Width="60" Height="26" Margin="6,0" ToolTip="{loc:Loc Ed_AfterTimeHint}"/>
                    <TextBlock Text="{loc:Loc Ed_HourAfter}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 环境条件：星期和时刻只看钟表，这三条看机器此刻的状态。留空 / 选「不限」= 不设限。 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,3">
                    <TextBlock Text="{loc:Loc Ed_IfProcess}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="IfProcModeCombo" AutomationProperties.Name="{loc:Loc Ed_IfProcess}" Width="150" Height="28" SelectionChanged="IfProcMode_Changed"/>
                    <TextBox x:Name="IfProcBox" AutomationProperties.Name="{loc:Loc Ed_IfProcess}" Width="140" Height="28" Margin="8,0,0,0"/>
                    <Button x:Name="IfProcPickBtn" Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Pick}" AutomationProperties.Name="{loc:Loc Btn_Pick}" Margin="8,0,0,0" Click="PickIfProcess_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{loc:Loc Ed_IfPower}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="IfPowerCombo" AutomationProperties.Name="{loc:Loc Ed_IfPower}" Width="150" Height="28"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{loc:Loc Ed_IfPath}" Width="108" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="IfPathBox" AutomationProperties.Name="{loc:Loc Ed_IfPath}" Width="300" Height="28"/>
                    <Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="8,0,0,0" Click="BrowseIfPath_Click"/>
                    <Button x:Name="IfPathVarBtn" Style="{StaticResource PickerButton}" Content="{}{ }" ToolTip="{loc:Loc Btn_InsertVar}" AutomationProperties.Name="{loc:Loc Btn_InsertVar}" Margin="6,0,0,0" Click="PickIfPathVar_Click"/>
                </StackPanel>
                <TextBlock x:Name="IfPathPreview" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4" Visibility="Collapsed"/>
                <TextBlock Text="{loc:Loc Ed_IfPathHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="118,0,0,4"/>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,10,0">
            <Button Content="{loc:Loc Ed_Ok}" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
