<Window x:Class="Clockwork.Views.GestureAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Gesture_Appearance}" SizeToContent="Width,Height" MaxHeight="392" MinWidth="352"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushInk}">
    <!-- 笔迹外观：手势那条线画成什么样。
         为什么单独一扇窗，而不是在管理器里加几行：管理器**没有余量**了——
         它是 SizeToContent="Height"，空列表时内容就 390 高，而那扇窗的兜底 MaxHeight 是 392
         （=最紧那一档 464 减 72 边距；探测失败时生效的就是它）。
         再往里塞控件，被挤到窗外去的是底下那行「关闭」——而那行恰恰是最不该丢的。

         **预览给两份底色，这是这一扇窗存在的理由。** 描边那一层（线底下那层半透明的黑）
         存在的全部意义就是「白文档上、深色 IDE 上都读得出来」，
         而它在深色底上几乎看不见——只给一份深底预览，恰好看不见描边在干什么。
         浅底那份是白纸一样的浅色，深底那份是深色窗口，两边都画同一段弧。

         两块底色写死成字面色而不跟主题走：这一条线压在的是**别的程序**的窗口上，
         主题只管本程序自己的界面，管不到那些窗是什么颜色。 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 预览：浅底一份、深底一份。画布由代码填（GestureTrailRenderer 画的就是屏幕上那条线）。 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LightBox" Grid.Column="0" Width="156" Height="96" Background="#F3EEE1"
                    CornerRadius="6" ClipToBounds="True" Margin="0,0,8,0"/>
            <Border x:Name="DarkBox" Grid.Column="1" Width="156" Height="96" Background="#1C1E22"
                    CornerRadius="6" ClipToBounds="True"/>
        </Grid>

        <!-- 「不显示轨迹」那一档，预览里是没有东西的。
             什么都不画看着像预览坏了，所以这一档另给一句话说明。 -->
        <TextBlock x:Name="OffNote" Grid.Row="1" Text="{loc:Loc Gesture_Trail_Off}" Style="{StaticResource FieldHint}"
                   Margin="2,8,0,0" Visibility="Collapsed"/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Gesture_Style}" Style="{StaticResource FieldHint}"
                       VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="56"/>
            <ComboBox x:Name="StyleCbo" Grid.Row="0" Grid.Column="1" Width="150" SelectionChanged="Style_Changed"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Gesture_Trail}" Style="{StaticResource FieldHint}"
                       VerticalAlignment="Center" Margin="0,10,12,0"/>
            <ComboBox x:Name="WidthCbo" Grid.Row="1" Grid.Column="1" Width="150" SelectionChanged="Width_Changed"
                      Margin="0,10,0,0"/>
        </Grid>

        <!-- 尾迹淡出：尾巴变暗、笔尖留一段亮的。
             它动到了「画的是什么」——认一条手势靠的正是那条线的形状——
             所以它是个开关（可关），而不是又一种样式。 -->
        <CheckBox x:Name="FadeChk" Grid.Row="3" Content="{loc:Loc Gesture_Trail_Fade}"
                  Margin="0,14,0,0" Click="Fade_Changed"/>

        <Button Grid.Row="4" Content="{loc:Loc Btn_Close}" MinWidth="88" Height="32"
                HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
