<Window x:Class="Clockwork.Views.GestureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Gesture_Manager}" Width="820" SizeToContent="Height" MaxHeight="392" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushInk}">
    <!-- 手势管理器：手势自己的一块地方。
         早先手势是动作组编辑器里的一行，归属反了——绝大多数组不配手势，那一行对它们是纯累赘，
         而真想知道「我一共设了哪些手势」，得挨个打开每个组去看。手势少而全局，正需要一处总览。

         一条手势 = 一个动作 + 一条轨迹。动作是普通的步骤（十种里的任意一种），
         「跑一整个组」用 group 类型的步骤表达——所以「粘贴」「最小化」这类只作为手势存在的动作，
         不必先为它建一个动作组。新增走的是主界面同一个「新增 ▾」菜单与同一个步骤编辑器。

         左边列已绑的手势，右边是这一条的动作按钮与轨迹画布：选中谁就在编谁。 -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="3" Height="15" Background="{StaticResource BrushAccent}" CornerRadius="1.5" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Gesture_Manager}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold"
                           FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 总开关摆这儿而不是设置页：这扇窗从头到尾就是讲手势的，
                 「手势还开着吗」这个问题只会在看着这张列表时冒出来。
                 关掉即完全不监听右键——右键按住拖放临时要用时，翻这一个开关，
                 比把列表里每一条逐个取消勾选、事后再逐个勾回来强。 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 右键此刻有没有真的被监听。放在总开关左边，因为它回答的是那个勾**生效了吗**——
                     勾着却没装上（Windows 拒绝、或钩子被静默卸掉）是这个功能唯一真正难查的状态。 -->
                <TextBlock x:Name="WatchState" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,14,0"/>
                <!-- 重新挂钩：把钩子摘掉再装一次，插到钩子链最前面。
                     别的程序（鼠标驱动、AutoHotkey、另一个手势软件）若排在前面并吞掉右键按下，
                     我们这边一切正常却永远收不到右键——而钩子链是「后装的排在前面」，
                     所以重装一次就能抢回队首。这件事程序自己判断不了（那时钩子活得好好的），
                     只能留一颗按钮。 -->
                <Button x:Name="RehookBtn" Content="{loc:Loc Gesture_Rehook}" Margin="0,0,12,0"
                        MinWidth="0" Padding="10,3" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Gesture_RehookHint}" Click="Rehook_Click"/>
                <CheckBox x:Name="GesturesOnChk" Content="{loc:Loc Gesture_Enabled}"
                          VerticalAlignment="Center" Click="GesturesOn_Changed"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{loc:Loc Gesture_Hint}" Style="{StaticResource FieldHint}"
                   TextWrapping="Wrap" Margin="14,0,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 已绑的手势。缩略图画的是真实笔迹（GestureGlyph），不是箭头文字：
                 认一条手势靠形状，而列表里看到的那一笔，就是你在右边画的那一笔。 -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BrushSlate}" BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="1" CornerRadius="8" MinHeight="150">
                <Grid>
                    <ListBox x:Name="Bound" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="{loc:Loc Gesture_Manager}"
                             SelectionChanged="Bound_SelectionChanged" MouseDoubleClick="Bound_DoubleClick"/>
                    <!-- 空态不放在 ListBox 里：它是「这里还没有东西」的说明，不是一个可选项。 -->
                    <TextBlock x:Name="EmptyNote" Text="{loc:Loc Gesture_None}" Style="{StaticResource FieldHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="320" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 三颗按钮作用于**列表**，所以贴着列表放，不跟轨迹挤在右栏——
                 右栏那一块只回答一个问题：选中的这条长什么样。 -->
            <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                <Button x:Name="AddBtn" Content="{loc:Loc Btn_AddMenu}" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" Margin="0,0,8,0" Click="Add_Click"/>
                <Button x:Name="EditBtn" Content="{loc:Loc Btn_Edit}" MinWidth="80" Margin="0,0,8,0" Click="Edit_Click"/>
                <Button x:Name="DelBtn" Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}"
                        MinWidth="80" Margin="0,0,8,0" Click="Del_Click"/>
                <Button x:Name="AppBtn" MinWidth="96" Click="App_Click"/>
            </WrapPanel>

            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="196" Margin="14,0,0,0">
                <TextBlock Text="{loc:Loc Gesture_Track}" Style="{StaticResource GroupLabel}" Margin="2,0,0,4"/>
                <Border x:Name="GestureCanvas" Height="150" Background="{DynamicResource BrushInk}"
                        BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="6"
                        Cursor="Pen" ClipToBounds="True"
                        MouseLeftButtonDown="GestureCanvas_Down" MouseMove="GestureCanvas_Move"
                        MouseLeftButtonUp="GestureCanvas_Up" MouseLeave="GestureCanvas_Leave">
                    <Grid>
                        <TextBlock x:Name="GestureWatermark" Text="{loc:Loc Ed_GestureDrawHere}" Foreground="{DynamicResource BrushFaint}"
                                    FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    TextWrapping="Wrap" TextAlignment="Center" Margin="8,0"/>
                        <ContentControl x:Name="GestureShape" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Polyline x:Name="GestureTrail" Stroke="{DynamicResource BrushAccentText}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Border>
                <!-- 只有「置顶」这一档才有的说明：它是开关，同一条手势管钉住和放开。
                     这句话原本只活在步骤编辑器里，而**看列表的时候才是会冒出这个疑问的时候**——
                     标签写着「置顶当前窗口」，读起来像单向动作，于是「那取消置顶呢」。
                     复用编辑器那条现成的文案（Ed_TopmostHint），不新增文案键。 -->
                <TextBlock x:Name="TopmostHint" Text="{loc:Loc Ed_TopmostHint}" Style="{StaticResource FieldHint}"
                           TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Gesture_Sensitivity}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldHint}"/>
                <ComboBox x:Name="SensitivityCbo" Width="110" SelectionChanged="Sensitivity_Changed" Margin="0,0,16,0"/>
                <TextBlock Text="{loc:Loc Gesture_Trail}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldHint}"/>
                <ComboBox x:Name="TrailWidthCbo" Width="90" SelectionChanged="TrailWidth_Changed"/>
            </StackPanel>
            <Button Content="{loc:Loc Btn_Close}" HorizontalAlignment="Right" Width="96"
                    IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
