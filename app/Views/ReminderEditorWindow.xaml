<Window x:Class="Clockwork.Views.ReminderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Ed_Title_Reminder}" Width="640" SizeToContent="Height" MaxHeight="840" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushInk}"
        ShowInTaskbar="False" MinWidth="560" MinHeight="400">
    <!-- 窗宽 640 而非 600：「循环运行 … 直到 [__] （HH:mm，留空=当天结束）」是本窗最长的一行，
         600 宽下中文正好把收尾的括号切掉。这一行是横排、不换行的，宽度只能由窗口给。 -->
    <!-- 右边距 6：同步骤编辑器——滚动条贴窗口边缘，别被边距包进内容区（见那边的注释）。 -->
    <Grid Margin="16,16,6,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 横向滚动条是兜底而非常态：18 种语言里总有更长的译文，宁可给一条可拖的滚动条，
             也别像现在这样把行尾无声切掉——被切掉的那半句用户根本不知道存在。 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource FormScroll}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Trigger}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="TrigCombo" AutomationProperties.Name="{loc:Loc Ed_Trigger}" Width="200" Height="28" SelectionChanged="Trig_Changed"/></StackPanel>

                <StackPanel x:Name="TimeRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Time}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="TimeBox" AutomationProperties.Name="{loc:Loc Ed_Time}" Width="100" Height="28"/></StackPanel>

                <StackPanel x:Name="StartupRow" Margin="0,3">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Loc Ed_LoginTiming}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="SModeCombo" AutomationProperties.Name="{loc:Loc Ed_LoginTiming}" Width="130" Height="28" SelectionChanged="SMode_Changed"/>
                        <TextBox x:Name="SHourBox" AutomationProperties.Name="{loc:Loc Ed_LoginTiming}" Width="50" Height="28" Margin="8,0,4,0"/><TextBlock x:Name="SHourLbl" Text="{loc:Loc Ed_Hour}" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="100,4,0,0"><TextBlock Text="{loc:Loc Ed_OnlyBoot}" VerticalAlignment="Center"/><TextBox x:Name="SWithinBox" AutomationProperties.Name="{loc:Loc Ed_OnlyBoot}" Width="50" Height="26" Margin="6,0"/><TextBlock Text="{loc:Loc Ed_WithinHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>

                <!-- 事件触发的两个参数行：只有「空闲时」「电量偏低时」用得上，其余事件没有参数 -->
                <StackPanel x:Name="IdleRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_IdleMinutes}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="IdleBox" AutomationProperties.Name="{loc:Loc Ed_IdleMinutes}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_IdleHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                <StackPanel x:Name="BatteryRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_BatteryPercent}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="BatteryBox" AutomationProperties.Name="{loc:Loc Ed_BatteryPercent}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_BatteryHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                <StackPanel x:Name="EventDaysRow" Margin="0,3">
                    <TextBlock Text="{loc:Loc Ed_EventHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="100,0,0,4"/>
                </StackPanel>

                <StackPanel x:Name="PeriodRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Period}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="RecurCombo" AutomationProperties.Name="{loc:Loc Ed_Period}" Width="160" Height="28" SelectionChanged="Recur_Changed"/></StackPanel>

                <StackPanel x:Name="DaysRow" Orientation="Horizontal" Margin="100,3,0,3">
                    <CheckBox x:Name="Day1" Content="{loc:Loc Day_1}" Margin="0,0,10,0"/><CheckBox x:Name="Day2" Content="{loc:Loc Day_2}" Margin="0,0,10,0"/><CheckBox x:Name="Day3" Content="{loc:Loc Day_3}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="Day4" Content="{loc:Loc Day_4}" Margin="0,0,10,0"/><CheckBox x:Name="Day5" Content="{loc:Loc Day_5}" Margin="0,0,10,0"/><CheckBox x:Name="Day6" Content="{loc:Loc Day_6}" Margin="0,0,10,0"/><CheckBox x:Name="Day7" Content="{loc:Loc Day_7}" Margin="0,0,10,0"/>
                </StackPanel>
                <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_EveryNDays}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="IntervalBox" AutomationProperties.Name="{loc:Loc Ed_EveryNDays}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_AnchorDays}" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="AnchorBox" AutomationProperties.Name="{loc:Loc Ed_AnchorDays}" Width="110" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_PickDate}" AutomationProperties.Name="{loc:Loc Btn_PickDate}" Margin="6,0,0,0" Click="PickAnchor_Click"/><TextBlock Text="{loc:Loc Ed_AnchorHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                <StackPanel x:Name="MonthlyRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_MonthlyDay}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="MonthlyBox" AutomationProperties.Name="{loc:Loc Ed_MonthlyDay}" Width="60" Height="28"/></StackPanel>
                <StackPanel x:Name="OnceRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_OnceDate}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="OnceDateBox" AutomationProperties.Name="{loc:Loc Ed_OnceDate}" Width="110" Height="28"/><Button Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_PickDate}" AutomationProperties.Name="{loc:Loc Btn_PickDate}" Margin="6,0,0,0" Click="PickOnce_Click"/></StackPanel>

                <!-- 动作二选一：只是 SilentGroupId 的视图（非空=静默）。选哪边就只显示哪边控件，见 UpdateAction。 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{loc:Loc Ed_Action}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ActPopup" Content="{loc:Loc Ed_ActPopup}" GroupName="RemAction" VerticalAlignment="Center" Checked="Action_Changed"/>
                    <RadioButton x:Name="ActSilent" Content="{loc:Loc Ed_ActSilent}" GroupName="RemAction" Margin="18,0,0,0" VerticalAlignment="Center" Checked="Action_Changed"/></StackPanel>
                <StackPanel x:Name="SilentRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_SilentGroup}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="SilentCombo" AutomationProperties.Name="{loc:Loc Ed_SilentGroup}" Width="240" Height="28"/></StackPanel>
                <!-- 交叉口指路：「登录时 + 静默动作组」与启动清单是同一件事的两条路。指路牌立在路口
                     ——只有真选出这个组合的人才看得到（见 UpdateCrossingHint），诚实写两边各自赢在哪。 -->
                <TextBlock x:Name="LoginSilentHint" Text="{loc:Loc Ed_LoginSilentHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="100,2,0,4"/>

                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Text}" Width="90" TextWrapping="Wrap" Margin="0,4,10,0" VerticalAlignment="Top"/><TextBox x:Name="MsgBox" AutomationProperties.Name="{loc:Loc Ed_Text}" Width="420" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                <CheckBox x:Name="SpeakChk" Content="{loc:Loc Ed_Speak}" Margin="100,3,0,3"/>
                <CheckBox x:Name="SoundChk" Content="{loc:Loc Ed_Sound}" Margin="100,3,0,3"/>

                <StackPanel x:Name="OnYesRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_OnYes}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox x:Name="OnYesTypeCombo" AutomationProperties.Name="{loc:Loc Ed_OnYes}" Width="140" Height="28" SelectionChanged="OnYesType_Changed"/>
                    <TextBox x:Name="OnYesTargetBox" AutomationProperties.Name="{loc:Loc Ed_OnYes}" Width="150" Height="28" Margin="8,0,0,0"/><Button x:Name="OnYesBrowseBtn" Style="{StaticResource PickerButton}" ToolTip="{loc:Loc Btn_Browse}" AutomationProperties.Name="{loc:Loc Btn_Browse}" Margin="6,0,0,0" Click="BrowseOnYes_Click"/><ComboBox x:Name="OnYesGroupCombo" AutomationProperties.Name="{loc:Loc Ed_OnYes}" Width="220" Height="28" Margin="8,0,0,0"/></StackPanel>

                <!-- 进阶整块折叠：自动关闭 / 催促 / 循环 / 延迟 / 宽限 / 错过必补。新用户建一条「10:00 提醒喝水」
                     不必面对这六行——收起时折叠条标题是一句实时生成的行为描述（UpdateAdvHeader），
                     「循环 vs 催促」这个最需要文档才讲得清的区别，被翻译成了一句话；配过任意一项的自动展开。 -->
                <Expander x:Name="AdvExp" Margin="0,10,0,0">
                <StackPanel Margin="0,4,0,0">
                <StackPanel x:Name="AutoRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_AutoDismiss}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="AutoBox" AutomationProperties.Name="{loc:Loc Ed_AutoDismiss}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_AutoHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                <StackPanel x:Name="NagRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_RepeatNag}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="RepeatBox" AutomationProperties.Name="{loc:Loc Ed_RepeatNag}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_RepeatUntilPre}" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="RepeatUntilBox" AutomationProperties.Name="{loc:Loc Ed_RepeatUntilPre}" Width="70" Height="28"/><TextBlock Text="{loc:Loc Ed_RepeatUntilHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                <StackPanel x:Name="LoopRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_LoopEvery}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="LoopMinBox" AutomationProperties.Name="{loc:Loc Ed_LoopEvery}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_LoopUntilPre}" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="LoopUntilBox" AutomationProperties.Name="{loc:Loc Ed_LoopUntilPre}" Width="70" Height="28"/><TextBlock Text="{loc:Loc Ed_LoopUntilHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_TrigDelay}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="DelayBox" AutomationProperties.Name="{loc:Loc Ed_TrigDelay}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_DelaySecPlus}" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="RandomBox" AutomationProperties.Name="{loc:Loc Ed_DelaySecPlus}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_Sec}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                <StackPanel x:Name="GraceRow" Orientation="Horizontal" Margin="0,3"><TextBlock Text="{loc:Loc Ed_Grace}" Width="90" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox x:Name="GraceBox" AutomationProperties.Name="{loc:Loc Ed_Grace}" Width="60" Height="28"/><TextBlock Text="{loc:Loc Ed_GraceHint}" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                <StackPanel x:Name="CatchUpRow" Orientation="Horizontal" Margin="0,3"><TextBlock Width="90" Margin="0,0,10,0"/><CheckBox x:Name="CatchUpChk" Content="{loc:Loc Ed_CatchUp}" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,10,0">
            <Button Content="{loc:Loc Ed_Ok}" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
