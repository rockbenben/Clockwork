<Window x:Class="Clockwork.Views.GroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Ed_Title_Group}" Width="720" Height="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushInk}"
        ShowInTaskbar="False" MinWidth="600" MinHeight="460">
    <!-- IsSharedSizeScope：让「新增」那一格与下方按钮列那一格共用宽度（SharedSizeGroup="StepRail"）。
         这两格分处两行不同的 Grid，各自算宽度就必然对不齐；而它们在视觉上是同一列按钮。
         此前是靠两处都写死 Width=104 手动同步的——按钮列改成随语言自适应之后那个约定就断了，
         德语实测「新增」比「编辑」窄了一大截、左右缘全错开。交给共享尺寸组，谁也不用记住那个数字。
         注意别让任何元素 ColumnSpan 跨过共享列（设置页实测会把布局转成无限循环），这里没有。 -->
    <Grid Margin="18,16,18,16" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- 主体：整体可滚 -->
            <RowDefinition Height="Auto"/>   <!-- 确定 / 取消：钉在底部，任何高度下都点得着 -->
        </Grid.RowDefinitions>

        <!-- 主体套一层滚动条。**这不是保险，是量出来的**：
             1366×768 @150% 的可用高度只有 464，而这个窗口光表头就吃掉 270 上下——
             实测那一档下步骤表被压到只剩一行表头，一条步骤都看不见，也就没法编。
             整体可滚之后，窗口再矮也只是要滚一下，而不是有一块内容从此够不着。
             「确定 / 取消」留在外面：它们是任何高度下都必须点得着的东西，不该跟着内容滚走。 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 名称 + 热键 -->
                <RowDefinition Height="Auto"/>   <!-- 说明 -->
                <RowDefinition Height="Auto"/>   <!-- 「步骤」小标题 + 添加 -->
                <RowDefinition Height="*"/>      <!-- 步骤序列（主体）-->
            </Grid.RowDefinitions>

        <!-- ===== 表头：名称 + 全局热键 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Col_Name}" Style="{StaticResource FieldLabel}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" AutomationProperties.Name="{loc:Loc Col_Name}" Height="30" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Ed_GroupHotkey}" Style="{StaticResource FieldLabel}"/>
            <!-- Grid（Auto|*）而非横向 StackPanel：StackPanel 给子元素无限可用宽度，说明文字只能靠
                 写死的 MaxWidth 换行——340 是凭空定的，实测把「即停下。」断成「即停 / 下。」，
                 而右边还空着两百多像素。交给列宽决定，窗口宽窄都在正确的位置断。 -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="HotkeyBox" AutomationProperties.Name="{loc:Loc Ed_GroupHotkey}" Width="170" Height="30" Style="{StaticResource HotkeyCapture}"/>
                <TextBlock Grid.Column="1" Text="{loc:Loc Ed_GroupHotkeyHint}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- 顶对齐，不居中：右边那块在德语下会折成三行，而这个标签只有一行。
                 居中的话它落在第二行旁边——也就是紧挨着两个复选框，而它标的是第一行那个次数框。
                 实测德语 820 宽下就是这个样子：标签比它自己的输入框低了三十几像素。 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Ed_GroupRepeat}" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Top" Margin="0,14,0,0"/>
            <!-- WrapPanel 而非横向 StackPanel：正是本文件上面那条注释说的坑——横向 StackPanel
                 给子元素无限可用宽度，排不下不会换行、直接被右缘裁掉。
                 实测德语 820 宽下最后那个复选框被切成「Im Infobereich-Menü anzeig」。

                 **换行的单位是「一组」，不是「一个控件」。** 每个标签连同它的输入框各自包在一个
                 横向 StackPanel 里，断点只可能落在组与组之间。散着放的时候实测德语下
                 「仅在此程序上显示」这个标签留在了上一行的行尾，而它的输入框折到了下一行——
                 被裁掉半个词看得出是被裁了，拆成两行却看着像两个不相干的东西。 -->
            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                <!-- 「重复 N 轮，每轮间隔 M 毫秒」是一句话，中间断开就不成话了。
                     单位并入 Ed_GroupRepeatDelay 文案（各语言自带 ms 缩写，同 Ed_DelayMs）：
                     写死的 "ms" 阿拉伯语/俄语用户会看到一截拉丁字母。 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="GroupRepeatBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeat}" Width="60" Height="28"/>
                    <TextBlock Text="{loc:Loc Ed_GroupRepeatDelay}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="GroupRepeatDelayBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeatDelay}" Width="80" Height="28"/>
                </StackPanel>
                <!-- 托盘显示开关与「整组重复」同排：都是「这个组怎么被用」的属性，不占额外一行；
                     窄到放不下时它整个掉到下一行，而不是被裁掉半个词。 -->
                <CheckBox x:Name="ShowInTrayChk" Content="{loc:Loc Ed_GroupShowInTray}" VerticalAlignment="Center" Margin="24,0,0,6"/>
                <!-- 这里曾经还有「作为面板的一页」和「仅在此程序上显示」两项。它们随着
                     面板页独立成实体一起搬走了：一个动作不再会「是」一页，页有自己的名字、
                     分类和场景，全在面板管理器的页眉上就地改。 -->
                <!-- 本组被别处引用时（group 步骤）用的图标。设一次，所有指向它的格子都跟着。
                     显示图标本身，不显示码位——原值退到 ToolTip 里。 -->
                <StackPanel Orientation="Horizontal" Margin="24,0,0,6">
                    <TextBlock Text="{loc:Loc Ed_Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="GroupIconBtn" Width="46" Height="38"
                            ContentTemplate="{x:Null}" ToolTip="{loc:Loc Icon_Pick}"
                            AutomationProperties.Name="{loc:Loc Icon_Pick}" Click="BrowseGroupIcon_Click"/>
                </StackPanel>
            </WrapPanel>
        </Grid>

        <!-- 动作组只定义动作，触发在别处引用 -->
        <TextBlock Grid.Row="1" Text="{loc:Loc Ed_GroupHint}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- ===== 「步骤」小标题（刻字面板标签）+ 添加按钮 ===== -->
        <Grid Grid.Row="2" Margin="0,16,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="StepRail"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc Col_Steps}" Style="{StaticResource GroupLabel}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
            <!-- 这颗「新增」就摞在「编辑 / 删除 / 复制」正上方，宽度必须与它们一致，否则一列按钮的左右缘都对不齐。
                 靠共享尺寸组 StepRail 自动取齐（见窗口根 Grid 的说明），不再两处各写死一个 104。
                 Stretch：让它填满共享列，而不是按自身内容缩在里面。 -->
            <Button Grid.Column="1" x:Name="SAdd" Content="{loc:Loc Btn_AddMenu}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Height="30" Padding="4,0" Margin="14,0,0,0" Click="SAdd_Click"/>
        </Grid>

        <!-- ===== 步骤序列：强调色轨 · 类型徽标 · 摘要 · 延时（与启动清单同一套仪表化列表）===== -->
        <Grid Grid.Row="3" MinHeight="132">   <!-- 至少露出三行步骤：再少就只剩表头，看不出这一组在干什么 -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="StepRail"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ListPanel}">
                <!-- 禁点表头排序：步骤顺序即执行顺序，排序会让选中索引与模型错位（与主窗口三列表同理） -->
                <DataGrid x:Name="Steps" AutomationProperties.Name="{loc:Loc Col_Steps}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="SEdit_Click">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24" CanUserResize="False" CellTemplate="{StaticResource RailCell}" CellStyle="{StaticResource RailCellStyle}"/>
                        <DataGridTemplateColumn Header="{loc:Loc Col_Kind}" Width="Auto" MinWidth="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource KindChipCell}">
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource KindChip}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Col_Summary}" Binding="{Binding Summary}" Width="*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellEllipsis}"/>
                        <DataGridTextColumn Header="{loc:Loc Col_Delay}" Binding="{Binding DelayText}" Width="Auto" MinWidth="72"
                                            IsReadOnly="True" ElementStyle="{StaticResource DelayCol}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 选中步骤的操作：编辑 / 删除 / 上移 / 下移（次级操作靠边，主操作「添加」在小标题旁）-->
            <!-- 套滞动条：窗口高度被 FitToWorkArea 按工作区封顶后，这一列（7 个按钮，且
                 「运行这一步 / 运行整组」的标签在西语下会折成两行）比 * 行还高，末尾按钮会被窗口底边切掉半个。
                 与设置页左栏同一条结论：收紧间距只是把悬崖往后挪一格，滞动条才不挑窗口大小。 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- 宽度随语言自己长，不写死 104：那个数字是照中文标签量的。
                 俄语实测这六行（七个按钮）里有三行放不下要折行——上移/下移各两行、「运行这一步」三行、
                 「运行整组」两行，合计 10 行文字；摞起来超出可用高度，滚动条把最后两个按钮从字当中切开
                 （820x566 实测切在「Выполнить」的字腰上）。
                 约束是标签长度而不是竖向空间：让它一行放得下，同样六行按钮就只剩 6 行文字。
                 MinWidth 保住中文下的手感（实测中文表格宽度 683px 一分未变），
                 MaxWidth 挡住某个语言把步骤表挤瘦（德语最狠，820 窗口下表格 666→583px）。 -->
            <StackPanel MinWidth="104" MaxWidth="190" Margin="14,0,0,0">
                <Button Content="{loc:Loc Btn_Edit}" Margin="0,0,0,8" Click="SEdit_Click"/>
                <Button Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Click="SDel_Click"/>
                <Button Content="{loc:Loc Btn_Copy}" Margin="0,0,0,8" Click="SCopy_Click"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:Loc Btn_Up}" Padding="0,5" Margin="0,0,3,0" Click="SUp_Click"/>
                    <Button Grid.Column="1" Content="{loc:Loc Btn_Down}" Padding="0,5" Margin="3,0,0,0" Click="SDown_Click"/>
                </Grid>
                <!-- 两个试跑按钮保持纵向、各占一行。试过并排两列（照抄上移/下移的写法）：中文标签就已经
                     折成「▶ 运行 / 这一步」两行，德语俄语只会更长——折行后单个按钮反而比纵向两行更高，
                     可读性和这一列其余单行按钮的节奏也全乱了。这里的约束不是竖向空间，是标签长度。 -->
                <Button x:Name="SRunStep" Content="{loc:Loc Btn_RunStep}" Style="{StaticResource RunButton}" Margin="0,10,0,2" Click="SRunStep_Click"/>
                <Button x:Name="SRunGroup" Content="{loc:Loc Btn_RunGroup}" Style="{StaticResource RunButton}" Margin="0,4,0,2" Click="SRunGroup_Click"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- ===== 确定 / 取消 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Ed_Ok}" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
