<Window x:Class="Clockwork.Views.GroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Ed_Title_Group}" Width="720" Height="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushInk}"
        ShowInTaskbar="False" MinWidth="600" MinHeight="460">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 名称 + 热键 -->
            <RowDefinition Height="Auto"/>   <!-- 说明 -->
            <RowDefinition Height="Auto"/>   <!-- 「步骤」小标题 + 添加 -->
            <RowDefinition Height="*"/>      <!-- 步骤序列（主体）-->
            <RowDefinition Height="Auto"/>   <!-- 确定 / 取消 -->
        </Grid.RowDefinitions>

        <!-- ===== 表头：名称 + 全局热键 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Col_Name}" Style="{StaticResource FieldLabel}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" AutomationProperties.Name="{loc:Loc Col_Name}" Height="30" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Ed_GroupHotkey}" Style="{StaticResource FieldLabel}"/>
            <!-- Grid（Auto|*）而非横向 StackPanel：StackPanel 给子元素无限可用宽度，说明文字只能靠
                 写死的 MaxWidth 换行——340 是凭空定的，实测把「即停下。」断成「即停 / 下。」，
                 而右边还空着两百多像素。交给列宽决定，窗口宽窄都在正确的位置断。 -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="HotkeyBox" AutomationProperties.Name="{loc:Loc Ed_GroupHotkey}" Width="170" Height="30" Style="{StaticResource HotkeyCapture}"/>
                <TextBlock Grid.Column="1" Text="{loc:Loc Ed_GroupHotkeyHint}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Ed_GroupRepeat}" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="GroupRepeatBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeat}" Width="60" Height="28"/>
                <TextBlock Text="{loc:Loc Ed_GroupRepeatDelay}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <!-- 单位并入 Ed_GroupRepeatDelay 文案（各语言自带 ms 缩写，同 Ed_DelayMs）：写死的 "ms" 阿拉伯语/俄语用户会看到一截拉丁字母 -->
                <TextBox x:Name="GroupRepeatDelayBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeatDelay}" Width="80" Height="28"/>
                <!-- 托盘显示开关与「整组重复」同排：都是"这个组怎么被用"的属性，不占额外一行 -->
                <CheckBox x:Name="ShowInTrayChk" Content="{loc:Loc Ed_GroupShowInTray}" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 动作组只定义动作，触发在别处引用 -->
        <TextBlock Grid.Row="1" Text="{loc:Loc Ed_GroupHint}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,10,0,0"/>

        <!-- ===== 「步骤」小标题（刻字面板标签）+ 添加按钮 ===== -->
        <Grid Grid.Row="2" Margin="0,16,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc Col_Steps}" Style="{StaticResource GroupLabel}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
            <!-- 宽度/左边距必须与下方按钮列（Width=104, Margin=14,0,0,0）逐字相同：这颗「新增」就摞在
                 「编辑 / 删除 / 复制」正上方，宽度由内容决定时两边各差几像素，一列按钮的左右缘就都对不齐。 -->
            <Button Grid.Column="1" x:Name="SAdd" Content="{loc:Loc Btn_AddMenu}" Style="{StaticResource PrimaryButton}"
                    Width="104" Height="30" Padding="4,0" Margin="14,0,0,0" Click="SAdd_Click"/>
        </Grid>

        <!-- ===== 步骤序列：黄铜轨 · 类型徽标 · 摘要 · 延时（与启动清单同一套仪表化列表）===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ListPanel}">
                <!-- 禁点表头排序：步骤顺序即执行顺序，排序会让选中索引与模型错位（与主窗口三列表同理） -->
                <DataGrid x:Name="Steps" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="SEdit_Click">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24" CanUserResize="False" CellTemplate="{StaticResource RailCell}" CellStyle="{StaticResource RailCellStyle}"/>
                        <DataGridTemplateColumn Header="{loc:Loc Col_Kind}" Width="Auto" MinWidth="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource KindChipCell}">
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource KindChip}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Col_Summary}" Binding="{Binding Summary}" Width="*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellEllipsis}"/>
                        <DataGridTextColumn Header="{loc:Loc Col_Delay}" Binding="{Binding DelayText}" Width="Auto" MinWidth="72"
                                            IsReadOnly="True" ElementStyle="{StaticResource DelayCol}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 选中步骤的操作：编辑 / 删除 / 上移 / 下移（次级操作靠边，主操作「添加」在小标题旁）-->
            <StackPanel Grid.Column="1" Width="104" Margin="14,0,0,0">
                <Button Content="{loc:Loc Btn_Edit}" Margin="0,0,0,8" Click="SEdit_Click"/>
                <Button Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Click="SDel_Click"/>
                <Button Content="{loc:Loc Btn_Copy}" Margin="0,0,0,8" Click="SCopy_Click"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:Loc Btn_Up}" Padding="0,5" Margin="0,0,3,0" Click="SUp_Click"/>
                    <Button Grid.Column="1" Content="{loc:Loc Btn_Down}" Padding="0,5" Margin="3,0,0,0" Click="SDown_Click"/>
                </Grid>
                <!-- 两个试跑按钮保持纵向、各占一行。试过并排两列（照抄上移/下移的写法）：中文标签就已经
                     折成「▶ 运行 / 这一步」两行，德语俄语只会更长——折行后单个按钮反而比纵向两行更高，
                     可读性和这一列其余单行按钮的节奏也全乱了。这里的约束不是竖向空间，是标签长度。 -->
                <Button x:Name="SRunStep" Content="{loc:Loc Btn_RunStep}" Style="{StaticResource RunButton}" Margin="0,10,0,2" Click="SRunStep_Click"/>
                <Button x:Name="SRunGroup" Content="{loc:Loc Btn_RunGroup}" Style="{StaticResource RunButton}" Margin="0,4,0,2" Click="SRunGroup_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== 确定 / 取消 ===== -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Ed_Ok}" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
