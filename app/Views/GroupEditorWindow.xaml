<Window x:Class="Clockwork.Views.GroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Clockwork.I18n"
        Title="{loc:Loc Ed_Title_Group}" Width="1180" Height="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushInk}"
        ShowInTaskbar="False" MinWidth="940" MinHeight="560">
    <!-- 左中右三列，照 Quicker 的组合动作编辑器（getquicker.net/kc/help/doc/xaction-editor）：
           左侧模块工具箱（分类 + 搜索）、中间步骤定义、右侧变量与外观。

         为什么从「新增 ▾」一个下拉换成常驻工具箱：
           下拉只有展开的那一瞬间在屏上，而**找步骤这件事本身就要看**——
           上一次那版把 29 种类型分进 7 节，节名是自造的（「取值」那一节 Quicker 根本没有），
           而下拉长过工作区时末尾几项被悄悄藏进滚动箭头（见 StepMenu 的注释）。
           常驻工具箱把「这一节有哪些步骤」摊在眼前，还能搜。

         三列各自滚动：任何一列的内容变长都不该把另外两列推出窗口。
         「确定 / 取消」留在最下面那行，任何高度下都点得着（1366×768 @150% 的可用高度只有 464）。 -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 表头：名称 / 热键 / 重复 -->
            <RowDefinition Height="*"/>      <!-- 三列主体 -->
            <RowDefinition Height="Auto"/>   <!-- 确定 / 取消 -->
        </Grid.RowDefinitions>

        <!-- ===== 表头：名称 + 热键（重复与托盘挪到右栏「选项」那一页） ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="76"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="Auto" MinWidth="96"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Col_Name}" Style="{StaticResource FieldLabel}" Margin="0,6,10,0"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" AutomationProperties.Name="{loc:Loc Col_Name}" Height="30" Margin="0,0,16,8"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Ed_GroupHotkey}" Style="{StaticResource FieldLabel}" Margin="0,6,10,0"/>
            <TextBox   Grid.Column="3" x:Name="HotkeyBox" AutomationProperties.Name="{loc:Loc Ed_GroupHotkey}" Height="30" Margin="0,0,16,8" Style="{StaticResource HotkeyCapture}"/>
            <!-- 「进托盘」留在表头，**不进右栏的「选项」那一页**：TabControl 只把选中页交给键盘
                 导航，一颗待在非选中页里的 CheckBox 既拿不到焦点环（冒烟自查的焦点探针直接判它坏），
                 键盘用户也要先翻页才够得到它。开关是全局行为，不属于「这一页的设置」。 -->
            <CheckBox Grid.Column="3" Grid.Row="1" x:Name="ShowInTrayChk"
                      Content="{loc:Loc Ed_GroupShowInTray}" VerticalAlignment="Top" Margin="0,10,0,0"/>
        </Grid>

        <!-- ===== 三列主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="236"/>
            </Grid.ColumnDefinitions>

            <!--  左：模块工具箱  -->
            <Border Grid.Column="0" Style="{StaticResource ListPanel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Tbx_Title}" Style="{StaticResource GroupLabel}" Margin="10,10,10,0"/>

                    <!-- 搜索 + 分类各占一格，**不是一行两个**：标签长度不受控，
                         俄语「Сбросить фильтр」实测折行，而一行两个会让整列跟着变宽。 -->
                    <StackPanel Grid.Row="1" Margin="10,6,10,8">
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:Loc Tbx_Search}"
                                 Height="28" ToolTip="{loc:Loc Tbx_SearchTip}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <!-- DisplayMemberPath 不是可省的：不设的话 ComboBox 渲染的是 record 的
                             ToString()，下拉里就是一行 "SectionItem { Key = , Label = 全部 }"。
                             截图矩阵第一次渲染这一扇窗时抓到的正是它。 -->
                        <ComboBox x:Name="SectionBox" AutomationProperties.Name="{loc:Loc Tbx_Section}"
                                  DisplayMemberPath="Label"
                                  Height="28" Margin="0,6,0,0" SelectionChanged="SectionBox_SelectionChanged"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="Toolbox" AutomationProperties.Name="{loc:Loc Tbx_Title}"
                                 Background="Transparent" BorderThickness="0"
                                 MouseDoubleClick="Toolbox_DoubleClick"
                                 KeyDown="Toolbox_KeyDown">
                            <!-- 每一项的无障碍名取 Label。
                                 不给的话 WPF 退到 record 的 ToString()，读屏软件念出来的是
                                 「ToolItem { Label = 复制, Kind = keys, Seed = Clockwork.Core.LaunchStep, Glyph = }」
                                 ——工具箱里二十来项，一项一句 C# 记录转储。
                                 同一页的分类下拉早就踩过这个坑（上面 DisplayMemberPath 那条注释）。
                                 BasedOn 不能省：Theme.xaml 里那份 ListBoxItem 样式带着选中/悬停的模板，
                                 换掉它整列的选中高亮就没了。 -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 图标 + 名字，和面板上那一格是同一张字形表（PanelGlyph）。
                                         前景色不写死：ListBoxItem 的选中态会改 Foreground，
                                         而 Foreground 是继承属性，文字与图标一起跟着变。 -->
                                    <StackPanel Orientation="Horizontal" Margin="10,4">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13.5"
                                                   Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ToolboxEmpty" Text="{loc:Loc Tbx_Empty}" Style="{StaticResource Hint}"
                                   Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="200" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!--  中：步骤  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Col_Steps}" Style="{StaticResource GroupLabel}" Margin="2,0,0,6"/>

                <Grid Grid.Row="1" MinHeight="132">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ListPanel}">
                        <Grid>
                            <!-- 禁表头排序：步骤顺序即执行顺序，排序会让选中索引与模型错位。 -->
                            <DataGrid x:Name="Steps" AutomationProperties.Name="{loc:Loc Col_Steps}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                      HeadersVisibility="Column" SelectionMode="Single" AllowDrop="True" MouseDoubleClick="SEdit_Click">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="24" CanUserResize="False" CellTemplate="{StaticResource RailCell}" CellStyle="{StaticResource RailCellStyle}"/>
                                    <DataGridTemplateColumn Header="{loc:Loc Col_Kind}" Width="Auto" MinWidth="104">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Margin 来自 StepRowVm.IndentMargin：块里的子步骤按层级缩进。 -->
                                                <Border Style="{StaticResource KindChipCell}" Margin="{Binding IndentMargin}">
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource KindChip}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Loc Col_Summary}" Binding="{Binding Summary}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource CellEllipsis}"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Delay}" Binding="{Binding DelayText}" Width="Auto" MinWidth="72"
                                                        IsReadOnly="True" ElementStyle="{StaticResource DelayCol}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="StepsEmptyHint" Text="{loc:Loc Ed_StepsEmpty}" Style="{StaticResource Hint}"
                                       Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 套滞动条：窗口高度被 FitToWorkArea 封顶后，这一列（6 个按钮）比步骤表还高，
                         末尾按钮会被底边切掉半个（与设置页左栏同一条结论）。 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MinWidth="104" MaxWidth="190" Margin="14,0,0,0">
                        <Button Content="{loc:Loc Btn_Edit}" Margin="0,0,0,8" Click="SEdit_Click"/>
                        <Button Content="{loc:Loc Btn_Delete}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Click="SDel_Click"/>
                        <Button Content="{loc:Loc Btn_Copy}" Margin="0,0,0,8" Click="SCopy_Click"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{loc:Loc Btn_Up}" Padding="0,5" Margin="0,0,3,0" Click="SUp_Click"/>
                            <Button Grid.Column="1" Content="{loc:Loc Btn_Down}" Padding="0,5" Margin="3,0,0,0" Click="SDown_Click"/>
                        </Grid>
                        <Button x:Name="SRunStep" Content="{loc:Loc Btn_RunStep}" Style="{StaticResource RunButton}" Margin="0,8,0,2" Click="SRunStep_Click"/>
                        <Button x:Name="SRunGroup" Content="{loc:Loc Btn_RunGroup}" Style="{StaticResource RunButton}" Margin="0,2,0,2" Click="SRunGroup_Click"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--  右：变量 / 外观 / 选项 三张 tab（同 Quicker 组合动作编辑器的右栏）。
                 分 tab 而不是把三件事纵向堆在一列里：堆起来时「外观」永远是那一列最下面的一块，
                 而改图标恰恰是**建动作时最常要改**的一项——它得和你正在想的东西同时可见。 -->
            <Border Grid.Column="4" Style="{StaticResource ListPanel}" Padding="0">
                <TabControl x:Name="SideTabs">
                    <TabItem Header="{loc:Loc Ed_Vars}">
                        <Grid Margin="12,8,12,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <!-- 表头复用现成的列标题键：左边那格是变量名，右边那格是产出它的那一步的类型。
                                 没有这一行，「行    列表（多行输入）」读起来像一句话，
                                 而不是「变量叫行，由列表这一步产出」。 -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc Col_Name}" Style="{StaticResource GroupLabel}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc Col_Kind}" Style="{StaticResource GroupLabel}"/>
                            </Grid>
                            <ListBox x:Name="VarList" Grid.Row="1" AutomationProperties.Name="{loc:Loc Ed_Vars}"
                                     Background="Transparent" BorderThickness="0"
                                     MouseDoubleClick="VarList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource KindChip}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- **必须显式落 Grid.Row="1"**：不写就默认进 Row 0，而 Row 0 是那张
                                 Auto 表头行——这一段提示会跟列标题挤在同一行里叠着画，
                                 头两行还互相压印（实测截图）。 -->
                            <TextBlock x:Name="VarsEmptyHint" Grid.Row="1" Text="{loc:Loc Ed_VarsEmpty}"
                                       Style="{StaticResource Hint}"
                                       Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Loc Ed_Appearance}">
                        <StackPanel Margin="12,12,12,12">
                            <!-- 大预览：图标那一格在面板上只有 88px，这里给的是它的三倍多。
                                 挑图标是**看着挑**的（「这个形状像不像我要的那个」），
                                 而下面那颗按钮只有 46px——照着它挑等于凭记忆挑。 -->
                            <!-- ContentControl 而不是 Border：IconVisual.Fill 要的是一个宿主。
                                 边框与内边距挂在外面那个 Border 上。 -->
                            <Border Height="132" Style="{StaticResource ListPanel}"
                                    Background="{StaticResource BrushInk}" Margin="0,0,0,12">
                                <ContentControl x:Name="IconPreview" Focusable="False"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GroupIconBtn" Width="46" Height="38" ContentTemplate="{x:Null}"
                                        ToolTip="{loc:Loc Icon_Pick}" AutomationProperties.Name="{loc:Loc Icon_Pick}"
                                        Click="BrowseGroupIcon_Click"/>
                                <TextBlock x:Name="IconNameBox" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{loc:Loc Ed_Options}">
                        <StackPanel Margin="12,12,12,12">
                            <TextBlock Text="{loc:Loc Ed_GroupRepeat}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="GroupRepeatBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeat}" Width="56" Height="28"/>
                                <TextBlock Text="{loc:Loc Ed_GroupRepeatDelay}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <TextBox x:Name="GroupRepeatDelayBox" AutomationProperties.Name="{loc:Loc Ed_GroupRepeatDelay}" Width="72" Height="28"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== 确定 / 取消 ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc Ed_Ok}" Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{loc:Loc Ed_Cancel}" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
